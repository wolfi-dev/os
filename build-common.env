## common environment for builds on all architectures
export GOFLAGS=""
export GOTOOLCHAIN=local

# Use a reproducible hash seed when compiling Python bytecode
export PYTHONHASHSEED=0

# PREVENT SHA1-HULUD AND PACKAGEGATE ALWAYS
export npm_config_ignore_scripts='true'
export npm_config_git='/usr/bin/git'
export npm_config_shell='/bin/sh'
export npm_config_script_shell='/bin/sh'

# Do not download external Python builds with uv
UV_PYTHON_DOWNLOADS=never

# melange cache is not located on the same fs as the build environment
# so we fail to hardlink files. Instead of attempting to hardlink in
# the first place, just copy files
UV_LINK_MODE=copy

# Enable debug logs for uv. Longer builds can appear to stall when building
# source distributions, and logs related to any build failures may be omitted
# without debug logs
RUST_LOG=uv=debug
