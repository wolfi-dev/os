From 1f6380a141cce6501a67c785360ac45fa8556be1 Mon Sep 17 00:00:00 2001
Subject: [PATCH] update squashfs dep

Backport of the Cargo.toml hunk of upstream commit 1f6380a141cc. Cargo.lock
is regenerated in the melange pipeline instead.

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -237,8 +237,8 @@
 tower = { version = "0.5", features = ["timeout", "limit"] }
 tower-http = { version = "0.7", features = ["limit"] }
 once_cell = "1.21"
-am-fs-squashfs = "0.1.5"
-fs_core = { package = "am-fs-core", version = "0.2.24" }
+fs_squashfs = { package = "rust-fs-squashfs", version = "0.4" }
+fs_core = { package = "rust-fs-core", version = "0.3" }
 
 [lib]
 name = "cleave"
