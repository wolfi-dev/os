From 432423dd3f6380a995d8e29bd20524366cf3126b Mon Sep 17 00:00:00 2001
From: dann frazier <dann.frazier@chainguard.dev>
Date: Tue, 15 Sep 2026 11:33:32 -0600
Subject: [PATCH 11/18] Revert "env: use argz for NUL delimited parsing"

This reverts commit 21d87c126230f01f81546788592367107c5823a2.
NEWS left untouched.
---
 .gitignore     |  1 -
 bootstrap.conf |  1 -
 src/env.c      | 37 ++++++++++++++++++++++++++++---------
 3 files changed, 28 insertions(+), 11 deletions(-)

diff --git a/.gitignore b/.gitignore
index 56baf3c2d..ccf9b7911 100644
--- a/.gitignore
+++ b/.gitignore
@@ -53,7 +53,6 @@
 /lib/.gitignore
 /lib/alloca.h
 /lib/arg-nonnull.h
-/lib/argz.h
 /lib/arpa/inet.h
 /lib/assert.h
 /lib/byteswap.h
diff --git a/bootstrap.conf b/bootstrap.conf
index 56474edae..7b93e1364 100644
--- a/bootstrap.conf
+++ b/bootstrap.conf
@@ -38,7 +38,6 @@ gnulib_modules="
   areadlink-with-size
   areadlinkat-with-size
   argmatch
-  argz
   argv-iter
   assert
   assert-h
diff --git a/src/env.c b/src/env.c
index dd526b836..3195963dc 100644
--- a/src/env.c
+++ b/src/env.c
@@ -19,7 +19,6 @@
 #include <config.h>
 #include <stdio.h>
 #include <sys/types.h>
-#include <argz.h>
 #include <getopt.h>
 #include <c-ctype.h>
 #include <signal.h>
@@ -359,9 +358,10 @@ set_envvars_from_file (struct env_vector *env, char const *file)
   /* On native Windows, _putenv keeps _environ, _wenviron, and the process
      environment block synchronized.  Replacing environ directly would
      conflict with its ownership of those data structures.  */
-  char *assignment = NULL;
-  while ((assignment = argz_next (env0_from_buffer, size, assignment)))
+  char *end = env0_from_buffer + size;
+  for (char *assignment = env0_from_buffer; assignment < end; )
     {
+      char *next = assignment + strlen (assignment) + 1;
       char *eq = strchr (assignment, '=');
       if (! eq)
         error (EXIT_CANCELED, 0,
@@ -369,12 +369,20 @@ set_envvars_from_file (struct env_vector *env, char const *file)
                quoteaf_n (0, assignment), quoteaf_n (1, file));
 
       set_envvar (assignment, eq);
+      assignment = next;
     }
   return false;
 #else
   /* Construct and index the merged vector, rather than making putenv
      repeatedly scan the growing environment for every assignment.  */
-  idx_t file_count = argz_count (env0_from_buffer, size);
+  char *end = env0_from_buffer + size;
+  idx_t file_count = 0;
+  for (char *assignment = env0_from_buffer; assignment < end; )
+    {
+      char *next = assignment + strlen (assignment) + 1;
+      ++file_count;
+      assignment = next;
+    }
 
   if (file_count == 0)
     return false;
@@ -409,9 +417,9 @@ set_envvars_from_file (struct env_vector *env, char const *file)
     }
 
   idx_t merged_count = inherited_count;
-  char *assignment = NULL;
-  while ((assignment = argz_next (env0_from_buffer, size, assignment)))
+  for (char *assignment = env0_from_buffer; assignment < end; )
     {
+      char *next = assignment + strlen (assignment) + 1;
       char *eq = strchr (assignment, '=');
       if (! eq)
         {
@@ -433,6 +441,7 @@ set_envvars_from_file (struct env_vector *env, char const *file)
               ++merged_count;
             }
         }
+      assignment = next;
     }
 
   merged[merged_count] = NULL;
@@ -452,12 +461,22 @@ set_raw_environment_from_file (struct env_vector *env,
                                char const *file)
 {
   size_t size = read_env_file (file);
-  idx_t entry_count = argz_count (env0_from_buffer, size);
+  idx_t entry_count = 0;
+  for (size_t i = 0; i < size; ++i)
+    entry_count += env0_from_buffer[i] == '\0';
 
   env->allocated = entry_count + 1;
   env->variable = xnmalloc (env->allocated, sizeof *env->variable);
-  argz_extract (env0_from_buffer, size, env->variable);
-  env->used = entry_count;
+  env->used = 0;
+
+  char *entry = env0_from_buffer;
+  for (size_t i = 0; i < size; ++i)
+    if (env0_from_buffer[i] == '\0')
+      {
+        env->variable[env->used++] = entry;
+        entry = env0_from_buffer + i + 1;
+      }
+  env->variable[env->used] = NULL;
   environ = env->variable;
 }
 
-- 
