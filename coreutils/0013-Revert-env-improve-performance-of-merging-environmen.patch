From 310042c204b39e29c186a872c20abb1cd34830d6 Mon Sep 17 00:00:00 2001
From: dann frazier <dann.frazier@chainguard.dev>
Date: Tue, 15 Sep 2026 11:33:32 -0600
Subject: [PATCH 13/18] Revert "env: improve performance of merging
 environments"

This reverts commit 9c28113d8a6b1d6a7d38e331cf8dec6d74fece1c.
NEWS left untouched.
---
 bootstrap.conf         |   1 -
 src/env.c              | 132 +++--------------------------------------
 tests/env/env0-from.sh |  36 +----------
 3 files changed, 9 insertions(+), 160 deletions(-)

diff --git a/bootstrap.conf b/bootstrap.conf
index 7b93e1364..9b672369e 100644
--- a/bootstrap.conf
+++ b/bootstrap.conf
@@ -146,7 +146,6 @@ gnulib_modules="
   hard-locale
   hash
   hashcode-file-inode
-  hashcode-mem
   heap
   host-os
   human
diff --git a/src/env.c b/src/env.c
index 71322bc5e..24f2300ff 100644
--- a/src/env.c
+++ b/src/env.c
@@ -24,8 +24,6 @@
 #include <signal.h>
 
 #include "argmatch.h"  /* argmatch($QUOTING_STYLE).  */
-#include "hash.h"
-#include "hashcode-mem.h"
 #include "system.h"
 #include "operand2sig.h"
 #include "printenv.h"
@@ -239,27 +237,6 @@ entry_has_name (char const *entry, char const *name, idx_t name_length)
           && memeq (entry, name, name_length));
 }
 
-#if ! defined _WIN32 || defined __CYGWIN__
-/* Hash an environment vector slot by the name in its assignment.  */
-static size_t
-env_vector_slot_hash (void const *x, size_t table_size)
-{
-  char *const *slot = x;
-  char const *entry = *slot;
-  char const *eq = strchr (entry, '=');
-  return hash_pjw_bare (entry, eq - entry) % table_size;
-}
-
-static bool
-env_vector_slot_compare (void const *x, void const *y)
-{
-  char const *a = * (char *const *) x;
-  char const *b = * (char *const *) y;
-  char const *b_eq = strchr (b, '=');
-  return entry_has_name (a, b, b_eq - b);
-}
-#endif
-
 /* Remove the requested variables from ENV,
    directly, preserving other raw entries.  */
 static void
@@ -346,18 +323,12 @@ read_env_file (char const *file)
   return size;
 }
 
-/* Merge the NUL-delimited assignments in FILE into the environment.
-   Return true if ENV now owns the environment vector.  */
-static bool
-set_envvars_from_file (struct env_vector *env, char const *file)
+/* Merge the NUL-delimited assignments in FILE into the environment.  */
+static void
+set_envvars_from_file (char const *file)
 {
   size_t size = read_env_file (file);
 
-#if defined _WIN32 && ! defined __CYGWIN__
-  (void) env;
-  /* On native Windows, _putenv keeps _environ, _wenviron, and the process
-     environment block synchronized.  Replacing environ directly would
-     conflict with its ownership of those data structures.  */
   char *end = env0_from_buffer + size;
   for (char *assignment = env0_from_buffer; assignment < end; )
     {
@@ -371,82 +342,6 @@ set_envvars_from_file (struct env_vector *env, char const *file)
       set_envvar (assignment, eq);
       assignment = next;
     }
-  return false;
-#else
-  /* Construct and index the merged vector, rather than making putenv
-     repeatedly scan the growing environment for every assignment.  */
-  char *end = env0_from_buffer + size;
-  idx_t file_count = 0;
-  for (char *assignment = env0_from_buffer; assignment < end; )
-    {
-      char *next = assignment + strlen (assignment) + 1;
-      if (! strchr (assignment, '='))
-        error (EXIT_CANCELED, 0,
-               _("invalid variable specification %s in %s"),
-               quoteaf_n (0, assignment), quoteaf_n (1, file));
-      ++file_count;
-      assignment = next;
-    }
-
-  if (file_count == 0)
-    return false;
-
-  idx_t inherited_count = 0;
-  while (environ[inherited_count])
-    ++inherited_count;
-
-  if (IDX_MAX - inherited_count <= file_count)
-    xalloc_die ();
-  idx_t max_count = inherited_count + file_count;
-  char **merged = xnmalloc (max_count + 1, sizeof *merged);
-  memcpy (merged, environ, inherited_count * sizeof *merged);
-  merged[inherited_count] = NULL;
-
-  Hash_table *slot_table
-    = hash_initialize (max_count, NULL, env_vector_slot_hash,
-                       env_vector_slot_compare, NULL);
-  if (! slot_table)
-    xalloc_die ();
-
-  /* Index only the first occurrence of each inherited name, matching
-     putenv's replacement of the first such entry.  */
-  for (idx_t i = 0; i < inherited_count; ++i)
-    {
-      char *eq = strchr (merged[i], '=');
-      if (! eq)
-        continue;
-
-      if (! hash_insert (slot_table, &merged[i]))
-        xalloc_die ();
-    }
-
-  idx_t merged_count = inherited_count;
-  for (char *assignment = env0_from_buffer; assignment < end; )
-    {
-      char *next = assignment + strlen (assignment) + 1;
-      devmsg ("setenv:   %s\n", assignment);
-
-      char **slot = hash_lookup (slot_table, &assignment);
-      if (slot)
-        *slot = assignment;
-      else
-        {
-          merged[merged_count] = assignment;
-          if (! hash_insert (slot_table, &merged[merged_count]))
-            xalloc_die ();
-          ++merged_count;
-        }
-      assignment = next;
-    }
-
-  merged[merged_count] = NULL;
-  env->variable = merged;
-  env->used = merged_count;
-  env->allocated = max_count + 1;
-  environ = merged;
-  hash_free (slot_table);
-  return true;
-#endif
 }
 
 /* Replace the environment with the NUL-delimited entries in FILE,
@@ -1040,6 +935,7 @@ main (int argc, char **argv)
   char *argv0 = NULL;
   struct env_vector env_vector;
 #ifdef lint
+  env_vector.variable = NULL;
   char **initial_environ = environ;
 #endif
 
@@ -1144,20 +1040,11 @@ main (int argc, char **argv)
   else if (ignore_environment)
     {
       devmsg ("cleaning environ\n");
-#if defined _WIN32 && ! defined __CYGWIN__
       static char *dummy_environ[] = { NULL };
       environ = dummy_environ;
-#else
-      env_vector.variable = xnmalloc (1, sizeof *env_vector.variable);
-      env_vector.variable[0] = NULL;
-      env_vector.used = 0;
-      env_vector.allocated = 1;
-      environ = env_vector.variable;
-      env_vector_active = true;
-#endif
     }
   else if (env0_from_file)
-    env_vector_active = set_envvars_from_file (&env_vector, env0_from_file);
+    set_envvars_from_file (env0_from_file);
 
   if (! ignore_environment || env0_from_file)
     {
@@ -1208,12 +1095,9 @@ main (int argc, char **argv)
       for (char *const *e = environ; *e; ++e)
         print_envvar (*e, terminator, quote_output);
 #ifdef lint
-      if (env_vector_active)
-        {
-          environ = initial_environ;
-          free (env_vector.variable);
-          free (env0_from_buffer);
-        }
+      environ = initial_environ;
+      free (env_vector.variable);
+      free (env0_from_buffer);
 #endif
       return EXIT_SUCCESS;
     }
diff --git a/tests/env/env0-from.sh b/tests/env/env0-from.sh
index 70b0f0b76..ff49f8de2 100755
--- a/tests/env/env0-from.sh
+++ b/tests/env/env0-from.sh
@@ -63,7 +63,7 @@ printf '=value\0' >empty-name || framework_failure_
 env -i --env0-from=empty-name -0 >out || fail=1
 compare empty-name out || fail=1
 
-# Without -i, retain putenv-style replacement for duplicate names.
+# Without -i, retain putenv behavior for duplicate names.
 printf '%s\0' CU_ENV0_FROM_DUP=first CU_ENV0_FROM_DUP=last \
   >duplicates || framework_failure_
 QUOTING_STYLE=literal env --env0-from=duplicates >all || fail=1
@@ -71,40 +71,6 @@ grep '^CU_ENV0_FROM_DUP=' all >out || framework_failure_
 echo CU_ENV0_FROM_DUP=last >exp || framework_failure_
 compare exp out || fail=1
 
-# Check merging into an environment that already has duplicate and
-# nonstandard entries.  Native Windows cannot pass those entries through
-# its process environment block, and retains the system putenv merge path.
-case $host_os in
-  mingw* | windows*) ;;
-  *)
-    printf 'A=old1\0opaque\0A=old2\0B=old\0' >base \
-      || framework_failure_
-    printf 'A=new1\0C=new\0A=new2\0' >merge || framework_failure_
-    printf 'A=new2\0A=old2\0B=old\0C=new\0opaque\0' >exp \
-      || framework_failure_
-    LC_ALL=C sort -z exp >exp-sorted || framework_failure_
-    env -i --env0-from=base "$abs_top_builddir/src/env$EXEEXT" \
-      --env0-from=merge -0 >all || fail=1
-    LC_ALL=C sort -z all >out || framework_failure_
-    compare exp-sorted out || fail=1
-
-    printf 'B=old\0C=operand\0D=new\0opaque\0' >exp \
-      || framework_failure_
-    LC_ALL=C sort -z exp >exp-sorted || framework_failure_
-    env -i --env0-from=base "$abs_top_builddir/src/env$EXEEXT" \
-      --env0-from=merge -u A -0 C=operand D=new >all || fail=1
-    LC_ALL=C sort -z all >out || framework_failure_
-    compare exp-sorted out || fail=1
-
-    printf 'A=one\0' >base-grow || framework_failure_
-    printf 'B=two\0' >merge-grow || framework_failure_
-    printf 'A=one\0B=two\0C=three\0' >exp || framework_failure_
-    env -i --env0-from=base-grow "$abs_top_builddir/src/env$EXEEXT" \
-      --env0-from=merge-grow -0 C=three >out || fail=1
-    compare exp out || fail=1
-    ;;
-esac
-
 # With -i, preserve all entries byte-for-byte, including duplicate names,
 # entries without '=', and empty entries.
 printf 'A=first\0opaque\0A=last\0\0=value\0B=\0' >raw \
-- 
2.53.0

