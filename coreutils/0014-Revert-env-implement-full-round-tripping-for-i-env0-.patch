From d9acb3e25fc2bdb9143e4defea462a3c82787f21 Mon Sep 17 00:00:00 2001
From: dann frazier <dann.frazier@chainguard.dev>
Date: Tue, 15 Sep 2026 11:33:32 -0600
Subject: [PATCH 14/18] Revert "env: implement full round-tripping for -i
 --env0-from"

This reverts commit ebbff3d4cb8c5cb13d7b904aaad36d4d31889f97.
NEWS left untouched.
---
 doc/coreutils.texi     |  26 ++++----
 src/env.c              | 145 +++--------------------------------------
 tests/env/env0-from.sh |  41 +++---------
 3 files changed, 30 insertions(+), 182 deletions(-)

diff --git a/doc/coreutils.texi b/doc/coreutils.texi
index 573504fe9..b00a265fd 100644
--- a/doc/coreutils.texi
+++ b/doc/coreutils.texi
@@ -17574,21 +17574,17 @@ environment.
 Start with an empty environment, ignoring the inherited environment.
 
 @optItem{env,--env0-from,=@var{file}}
-Read NUL-terminated environment entries from @var{file}.  If @var{file}
-is @samp{-}, read from standard input.  The file must either be empty or
-end with a NUL byte.
-
-Without @option{--ignore-environment}, each entry must be a
-@samp{@var{name}=@var{value}} assignment.  Assignments replace inherited
-variables with the same name, and a later assignment in @var{file} takes
-precedence over an earlier one.
-
-With @option{--ignore-environment}, the entries replace the environment
-directly.  Their order and contents are preserved, including duplicate
-names, empty entries, and entries without an @samp{=} byte.  Thus this
-mode can round-trip the output from @samp{env -0} exactly.  Variables
-specified by @option{--unset} are then removed, and command-line
-assignments are then applied.
+Read NUL-terminated @samp{@var{name}=@var{value}} assignments from
+@var{file} and add them to the environment.  If @var{file} is
+@samp{-}, read from standard input.  The final assignment must be
+terminated by a NUL byte.
+
+Assignments from @var{file} replace inherited variables with the same
+name.  A later assignment in @var{file} takes precedence over an earlier
+one.  The @option{--ignore-environment} option starts with an empty
+environment before adding these assignments.  Variables specified by
+@option{--unset} are then removed, and command-line assignments take
+final precedence.
 
 @optItem{env,-C,@w{ }@var{dir}}
 @optItemx{env,--chdir,=@var{dir}}
diff --git a/src/env.c b/src/env.c
index 24f2300ff..8b9ba7741 100644
--- a/src/env.c
+++ b/src/env.c
@@ -45,17 +45,9 @@ static char const **usvars;
 static idx_t usvars_alloc;
 static idx_t usvars_used;
 
-/* Storage for entries read by --env0-from.  */
+/* Storage for variables passed to putenv from --env0-from.  */
 static char *env0_from_buffer;
 
-/* An environment vector managed directly to preserve raw entries.  */
-struct env_vector
-{
-  char **variable;
-  idx_t used;
-  idx_t allocated;
-};
-
 /* Annotate the output with extra info to aid the user.  */
 static bool dev_debug;
 
@@ -150,7 +142,7 @@ Set each NAME to VALUE in the environment and run COMMAND.\n\
 "));
       oputs (_("\
       --env0-from=FILE\n\
-         read NUL-delimited environment entries from FILE\n\
+         set variables from NUL-delimited assignments in FILE\n\
 "));
       oputs (_("\
   -0, --null\n\
@@ -228,39 +220,6 @@ unset_envvars (void)
     }
 }
 
-/* Return true if ENTRY is an assignment whose name is NAME.  */
-static bool
-entry_has_name (char const *entry, char const *name, idx_t name_length)
-{
-  char const *eq = strchr (entry, '=');
-  return (eq && eq - entry == name_length
-          && memeq (entry, name, name_length));
-}
-
-/* Remove the requested variables from ENV,
-   directly, preserving other raw entries.  */
-static void
-unset_envvars_in_vector (struct env_vector *env)
-{
-  for (idx_t i = 0; i < usvars_used; ++i)
-    {
-      char const *name = usvars[i];
-      devmsg ("unset:    %s\n", name);
-
-      if (! *name || strchr (name, '='))
-        error (EXIT_CANCELED, EINVAL, _("cannot unset %s"), quoteaf (name));
-
-      idx_t name_length = strlen (name);
-      idx_t dest = 0;
-      for (idx_t source = 0; source < env->used; ++source)
-        if (! entry_has_name (env->variable[source], name, name_length))
-          env->variable[dest++] = env->variable[source];
-
-      env->used = dest;
-      env->variable[dest] = NULL;
-    }
-}
-
 /* Add ASSIGNMENT to the environment.  EQ points to its '=' byte.  */
 static void
 set_envvar (char *assignment, char *eq)
@@ -274,36 +233,9 @@ set_envvar (char *assignment, char *eq)
     }
 }
 
-/* Add ASSIGNMENT to ENV directly, preserving other raw entries.
-   EQ points to its '=' byte.  Replace the first existing assignment
-   with the same name, as putenv does, or append ASSIGNMENT if none.  */
+/* Merge the NUL-delimited assignments in FILE into the environment.  */
 static void
-set_envvar_in_vector (struct env_vector *env, char *assignment, char *eq)
-{
-  devmsg ("setenv:   %s\n", assignment);
-
-  idx_t name_length = eq - assignment;
-  for (idx_t i = 0; i < env->used; ++i)
-    if (entry_has_name (env->variable[i], assignment, name_length))
-      {
-        env->variable[i] = assignment;
-        return;
-      }
-
-  if (env->used + 1 == env->allocated)
-    {
-      env->variable = xpalloc (env->variable, &env->allocated, 1, -1,
-                               sizeof *env->variable);
-      environ = env->variable;
-    }
-
-  env->variable[env->used++] = assignment;
-  env->variable[env->used] = NULL;
-}
-
-/* Read the NUL-delimited environment entries in FILE.  */
-static size_t
-read_env_file (char const *file)
+set_envvars_from_file (char const *file)
 {
   size_t size;
   if (streq (file, "-"))
@@ -320,15 +252,6 @@ read_env_file (char const *file)
     error (EXIT_CANCELED, 0, _("%s: file must end with a NUL byte"),
            quotef (file));
 
-  return size;
-}
-
-/* Merge the NUL-delimited assignments in FILE into the environment.  */
-static void
-set_envvars_from_file (char const *file)
-{
-  size_t size = read_env_file (file);
-
   char *end = env0_from_buffer + size;
   for (char *assignment = env0_from_buffer; assignment < end; )
     {
@@ -344,32 +267,6 @@ set_envvars_from_file (char const *file)
     }
 }
 
-/* Replace the environment with the NUL-delimited entries in FILE,
-   preserving the entries byte-for-byte and in their original order.  */
-static void
-set_raw_environment_from_file (struct env_vector *env,
-                               char const *file)
-{
-  size_t size = read_env_file (file);
-  idx_t entry_count = 0;
-  for (size_t i = 0; i < size; ++i)
-    entry_count += env0_from_buffer[i] == '\0';
-
-  env->allocated = entry_count + 1;
-  env->variable = xnmalloc (env->allocated, sizeof *env->variable);
-  env->used = 0;
-
-  char *entry = env0_from_buffer;
-  for (size_t i = 0; i < size; ++i)
-    if (env0_from_buffer[i] == '\0')
-      {
-        env->variable[env->used++] = entry;
-        entry = env0_from_buffer + i + 1;
-      }
-  env->variable[env->used] = NULL;
-  environ = env->variable;
-}
-
 /* Return a pointer to the end of a valid ${VARNAME} string, or NULL.
    'str' should point to the '$' character.
    First letter in VARNAME must be alpha or underscore,
@@ -933,11 +830,6 @@ main (int argc, char **argv)
   char const *newdir = NULL;
   char const *env0_from_file = NULL;
   char *argv0 = NULL;
-  struct env_vector env_vector;
-#ifdef lint
-  env_vector.variable = NULL;
-  char **initial_environ = environ;
-#endif
 
   initialize_main (&argc, &argv);
   set_program_name (argv[0]);
@@ -1030,37 +922,23 @@ main (int argc, char **argv)
         }
     }
 
-  bool env_vector_active = false;
-  if (ignore_environment && env0_from_file)
-    {
-      devmsg ("cleaning environ\n");
-      set_raw_environment_from_file (&env_vector, env0_from_file);
-      env_vector_active = true;
-    }
-  else if (ignore_environment)
+  if (ignore_environment)
     {
       devmsg ("cleaning environ\n");
       static char *dummy_environ[] = { NULL };
       environ = dummy_environ;
     }
-  else if (env0_from_file)
+
+  if (env0_from_file)
     set_envvars_from_file (env0_from_file);
 
   if (! ignore_environment || env0_from_file)
-    {
-      if (env_vector_active)
-        unset_envvars_in_vector (&env_vector);
-      else
-        unset_envvars ();
-    }
+    unset_envvars ();
 
   char *eq;
   while (optind < argc && (eq = strchr (argv[optind], '=')))
     {
-      if (env_vector_active)
-        set_envvar_in_vector (&env_vector, argv[optind], eq);
-      else
-        set_envvar (argv[optind], eq);
+      set_envvar (argv[optind], eq);
       optind++;
     }
 
@@ -1094,11 +972,6 @@ main (int argc, char **argv)
       /* Print the environment and exit.  */
       for (char *const *e = environ; *e; ++e)
         print_envvar (*e, terminator, quote_output);
-#ifdef lint
-      environ = initial_environ;
-      free (env_vector.variable);
-      free (env0_from_buffer);
-#endif
       return EXIT_SUCCESS;
     }
 
diff --git a/tests/env/env0-from.sh b/tests/env/env0-from.sh
index ff49f8de2..b5cd1612b 100755
--- a/tests/env/env0-from.sh
+++ b/tests/env/env0-from.sh
@@ -63,33 +63,14 @@ printf '=value\0' >empty-name || framework_failure_
 env -i --env0-from=empty-name -0 >out || fail=1
 compare empty-name out || fail=1
 
-# Without -i, retain putenv behavior for duplicate names.
-printf '%s\0' CU_ENV0_FROM_DUP=first CU_ENV0_FROM_DUP=last \
-  >duplicates || framework_failure_
-QUOTING_STYLE=literal env --env0-from=duplicates >all || fail=1
-grep '^CU_ENV0_FROM_DUP=' all >out || framework_failure_
-echo CU_ENV0_FROM_DUP=last >exp || framework_failure_
-compare exp out || fail=1
-
-# With -i, preserve all entries byte-for-byte, including duplicate names,
-# entries without '=', and empty entries.
-printf 'A=first\0opaque\0A=last\0\0=value\0B=\0' >raw \
-  || framework_failure_
-env -i --env0-from=raw -0 >out || fail=1
-compare raw out || fail=1
-env -0 --env0-from=raw - >out || fail=1
-compare raw out || fail=1
-
-# Apply -u and command-line assignments without normalizing other entries.
-printf 'opaque\0\0=value\0B=changed\0C=new\0' >exp \
-  || framework_failure_
-env -i --env0-from=raw -u A -0 B=changed C=new >out || fail=1
-compare exp out || fail=1
-
-# Appending beyond the loaded vector must update environ after reallocating.
-printf 'A=one\0' >one || framework_failure_
-printf 'A=one\0B=two\0' >exp || framework_failure_
-env -i --env0-from=one -0 B=two >out || fail=1
+# A later record for the same name takes precedence.
+printf 'A=first\0B=second\0A=last\0' >duplicates || framework_failure_
+cat <<\EOF >exp || framework_failure_
+A=last
+B=second
+EOF
+QUOTING_STYLE=literal env -i --env0-from=duplicates >all || fail=1
+LC_ALL=C sort all >out || framework_failure_
 compare exp out || fail=1
 
 # Read '-' in binary mode from standard input.
@@ -110,11 +91,11 @@ env -i --env0-from=path env0-from-command >out || fail=1
 compare exp out || fail=1
 
 # An empty file makes no changes, unless -i also requests an empty base.
-printf %s '' >empty || framework_failure_
+: >empty || framework_failure_
 env -i --env0-from=empty -0 >out || fail=1
 compare /dev/null out || fail=1
 
-# The file must end in NUL.  Without -i, every record is an assignment.
+# Every nonempty record must be a complete NUL-terminated assignment.
 printf 'A=unterminated' >invalid || framework_failure_
 returns_ 125 env --env0-from=invalid >out 2>err || fail=1
 printf 'not-an-assignment\0' >invalid || framework_failure_
@@ -126,7 +107,5 @@ returns_ 125 env --env0-from=does-not-exist >out 2>err || fail=1
 # Invalid -u names are still diagnosed after loading variables from a file.
 returns_ 125 env --env0-from=empty -u '' true || fail=1
 returns_ 125 env --env0-from=empty -u A=B true || fail=1
-returns_ 125 env -i --env0-from=empty -u '' true || fail=1
-returns_ 125 env -i --env0-from=empty -u A=B true || fail=1
 
 Exit $fail
