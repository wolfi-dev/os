diff --git a/doc/coreutils.texi b/doc/coreutils.texi
index b00a265fd..60a4b19c1 100644
--- a/doc/coreutils.texi
+++ b/doc/coreutils.texi
@@ -17573,19 +17573,6 @@ environment.
 @optItemx{env,--ignore-environment,}
 Start with an empty environment, ignoring the inherited environment.
 
-@optItem{env,--env0-from,=@var{file}}
-Read NUL-terminated @samp{@var{name}=@var{value}} assignments from
-@var{file} and add them to the environment.  If @var{file} is
-@samp{-}, read from standard input.  The final assignment must be
-terminated by a NUL byte.
-
-Assignments from @var{file} replace inherited variables with the same
-name.  A later assignment in @var{file} takes precedence over an earlier
-one.  The @option{--ignore-environment} option starts with an empty
-environment before adding these assignments.  Variables specified by
-@option{--unset} are then removed, and command-line assignments take
-final precedence.
-
 @optItem{env,-C,@w{ }@var{dir}}
 @optItemx{env,--chdir,=@var{dir}}
 Change the working directory to @var{dir} before invoking @var{command}.
diff --git a/src/env.c b/src/env.c
index 8b9ba7741..9c7aef854 100644
--- a/src/env.c
+++ b/src/env.c
@@ -28,7 +28,6 @@
 #include "operand2sig.h"
 #include "printenv.h"
