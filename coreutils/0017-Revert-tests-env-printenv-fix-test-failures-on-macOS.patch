From 0988270e87756ee1fd989f010b5b5d268d5404e1 Mon Sep 17 00:00:00 2001
From: dann frazier <dann.frazier@chainguard.dev>
Date: Tue, 15 Sep 2026 11:33:33 -0600
Subject: [PATCH 17/18] Revert "tests: env,printenv: fix test failures on
 macOS"

This reverts commit f5e1fd312683e039985c733037f81e6c1378ac2a.
NEWS left untouched.
---
 tests/env/env.sh       | 3 +--
 tests/misc/printenv.sh | 3 +--
 2 files changed, 2 insertions(+), 4 deletions(-)

diff --git a/tests/env/env.sh b/tests/env/env.sh
index a6eb6260b..a4cc00598 100755
--- a/tests/env/env.sh
+++ b/tests/env/env.sh
@@ -204,8 +204,7 @@ tr "'" '"' <exp-noargs-shell >exp-noargs-c || framework_failure_
 for qs in literal shell c; do
   env -i PATH="$PATH" QUOTING_STYLE=$qs 'a b'='c d' \
     env >out-t 2>err || fail=1
-  grep -vE '^["'"'"']?(__CF_USER_TEXT_ENCODING|QUOTING_STYLE|PATH)["'"'"']?=' \
-    out-t >out || framework_failure_
+  grep -vE 'QUOTING_STYLE|PATH' out-t > out || framework_failure_
   compare exp-noargs-$qs out || fail=1
   compare /dev/null err || fail=1
 done
diff --git a/tests/misc/printenv.sh b/tests/misc/printenv.sh
index 8ec228a6a..0cb90681e 100755
--- a/tests/misc/printenv.sh
+++ b/tests/misc/printenv.sh
@@ -98,8 +98,7 @@ tr "'" '"' <exp-args-shell >exp-args-c || framework_failure_
 for qs in literal shell c; do
   env -i PATH="$PATH" QUOTING_STYLE=$qs 'a b'='c d' \
     printenv >out-t 2>err || fail=1
-  grep -vE '^["'"'"']?(__CF_USER_TEXT_ENCODING|QUOTING_STYLE|PATH)["'"'"']?=' \
-    out-t >out || framework_failure_
+  grep -vE 'QUOTING_STYLE|PATH' out-t > out || framework_failure_
   compare exp-noargs-$qs out || fail=1
   compare /dev/null err || fail=1
   env -i PATH="$PATH" QUOTING_STYLE=$qs 'a b'='c d' \
-- 
2.53.0

