From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jacob Bachmeyer <jcb@gnu.org>
Date: Wed, 25 Mar 2026 19:46:36 -0500
Subject: [PATCH 1/5] Convert Tcl case to switch in baseboards/qemu.exp

(cherry picked from commit 3d1fa86a0801e982d817c2d15f34bce61c8e21c3, ChangeLog hunk dropped)
---
 baseboards/qemu.exp | 63 +++++++++++++++++++++------------------------
 1 file changed, 30 insertions(+), 33 deletions(-)

diff --git a/baseboards/qemu.exp b/baseboards/qemu.exp
index 193a759..345c2ee 100644
--- a/baseboards/qemu.exp
+++ b/baseboards/qemu.exp
@@ -1,5 +1,5 @@
 #
-# Copyright (C) 2020 Free Software Foundation, Inc.
+# Copyright (C) 2020, 2026 Free Software Foundation, Inc.
 #
 # This program is free software; you can redistribute it and/or modify
 # under the terms of the GNU General Public License as published by
@@ -64,99 +64,96 @@ if { [string length $specfiles] == 0 } {
 
 # The basic set of flags needed to build "hello world" for this
 # board. This board uses libgloss and newlib.
-case "$target_triplet" in {
-    { "armeb-*-eabi*" } {
+switch -glob -- $target_triplet {
+    "armeb-*-eabi*" {
 	set qemu "qemu-armeb"
 	set spec  "elf-rdimon.specs"
     }
-    { "arm-pi3-*" } {
+    "arm-pi3-*" {
 	set qemu "qemu-arm"
-	set spec="-static"
+	set spec "-static"
 	set target_list pi
     }
-    { "arm*-*-eabi*" } {
+    "arm*-*-eabi*" {
 	set qemu "qemu-arm"
-	set spec="-static"
+	set spec "-static"
 	set spec  "elf-rdimon.specs"
     }
-    { "aarch64be-*-elf" } {
+    "aarch64be-*-elf" {
 	set qemu "qemu-aarch64_be"
 	set spec  "rdimon.specs"
     }
-    { "aarch64*-gnu*" } {
+    "aarch64*-gnu*" {
 	set qemu "qemu-aarch64"
 	set spec  "-static"
     }
-    { "aarch64*-*elf*" } {
+    "aarch64*-*elf*" {
 	# There's multiple spec files, but rdimon is the
 	# one usually used for testing.
 	set qemu "qemu-aarch64"
 	set spec "rdimon.specs"
     }
-    # FIXME: These following qemu variants are just what QEMU
-    # supports, the pattern to match for the target needs to be
-    # researched.
-    { "cris*" } {
+    "cris*" {
 	set qemu "qemu-cris"
     }
-    { "microblaze-*" } {
+    "microblaze-*" {
 	set qemu "qemu-microblaze"
 	set spec "elf-gloss-linux.specs"
     }
-    { "microblazeel-*" } {
+    "microblazeel-*" {
 	set qemu "qemu-microblazeel"
 	set spec "elf-gloss-linux.specs"
     }
-    { "mips" } {
+    "mips" {
 	set qemu "qemu-mips"
     }
-    { "mips64-*" } {
+    "mips64-*" {
 	set qemu "qemu-mips64"
     }
-    { "mips64el-*" } {
+    "mips64el-*" {
 	set qemu "qemu-mips64el"
     }
-    { "mipsel-*" } {
+    "mipsel-*" {
 	set qemu "qemu-mipsel"
     }
-    { "mipsn32-*" } {
+    "mipsn32-*" {
 	set qemu "qemu-mipsn32"
     }
-    { "mipsn32el-*" } {
+    "mipsn32el-*" {
 	set qemu "qemu-mipsn32el"
     }
-    { "ppc-*" } {
+    "ppc-*" {
 	set qemu "qemu-ppc"
     }
-    { "ppc64-*" } {
+    "ppc64-*" {
 	set qemu "qemu-ppc64"
     }
-    { "ppc64abi32-*" } {
+    "ppc64abi32-*" {
 	set qemu "qemu-ppc64abi32"
     }
-    { "ppc64le-*" } {
+    "ppc64le-*" {
 	set qemu "qemu-ppc64le"
     }
-    { "riscv32-elf" } {
+    "riscv32-elf" {
 	set qemu "qemu-riscv32"
     }
-    { "riscv64-elf" } {
+    "riscv64-elf" {
 	set qemu "qemu-riscv64"
 	set spec "nano.spec"
     }
-    { "sh4-*" } {
+    "sh4-*" {
 	set qemu "qemu-sh4"
     }
-    { "sh4eb-*" } {
+    "sh4eb-*" {
 	set qemu "qemu-sh4eb"
     }
-    { "sparc=*" } {
+    "sparc=*" {
 	set qemu "qemu-sparc"
     }
-    { "sparc32plus-*" } {
+    "sparc32plus-*" {
 	set qemu "qemu-sparc32plus"
     }
-    { "sparc64-*" } {
+    "sparc64-*" {
 	set qemu "qemu-sparc64"
     }
     default {
