From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jacob Bachmeyer <jcb@gnu.org>
Date: Thu, 26 Mar 2026 20:01:44 -0500
Subject: [PATCH 2/5] Change use of fconfigure(n) to accommodate Tcl 9

(cherry picked from commit 6f18e7a98ccd6e2f634ab56dbf965c94d7df73b2, ChangeLog hunk dropped)
---
 lib/utils.exp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/lib/utils.exp b/lib/utils.exp
index d74c3b8..5d68ad8 100644
--- a/lib/utils.exp
+++ b/lib/utils.exp
@@ -1,4 +1,4 @@
-# Copyright (C) 1992-2019, 2020 Free Software Foundation, Inc.
+# Copyright (C) 1992-2019, 2020, 2026 Free Software Foundation, Inc.
 #
 # This file is part of DejaGnu.
 #
@@ -303,7 +303,7 @@ proc diff { file_1 file_2 } {
 
     if {[file exists $file_1]} {
 	set file_a [open $file_1 r]
-	fconfigure $file_a -encoding binary
+	fconfigure $file_a -translation binary
     } else {
 	warning "$file_1 doesn't exist"
 	return 0
@@ -311,7 +311,7 @@ proc diff { file_1 file_2 } {
 
     if {[file exists $file_2]} {
 	set file_b [open $file_2 r]
-	fconfigure $file_b -encoding binary
+	fconfigure $file_b -translation binary
     } else {
 	warning "$file_2 doesn't exist"
 	return 0
