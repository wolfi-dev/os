From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jacob Bachmeyer <jcb@gnu.org>
Date: Thu, 2 Apr 2026 22:32:41 -0500
Subject: [PATCH 3/5] Ensure that testsuites run in the POSIX locale

(cherry picked from commit 90ffbb7db86494641f9578e953575befb8dadca6, ChangeLog hunk dropped; context adjusted for 1.6.3, which lacks the Zsh prologue)
---
 runtest | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/runtest b/runtest
index 807a6ae..e0be125 100755
--- a/runtest
+++ b/runtest
@@ -1,6 +1,6 @@
 #!/bin/sh
 #
-# Copyright (C) 1992-2016, 2021 Free Software Foundation, Inc.
+# Copyright (C) 1992-2016, 2021, 2026 Free Software Foundation, Inc.
 #
 # This file is part of DejaGnu.
 #
@@ -33,6 +33,10 @@
 # is simple enough to work.  Most notably, nesting backtick command
 # substitution is tricky, but we do not do that.
 
+# Ensure that DejaGnu will be run in the POSIX locale
+LC_ALL=C
+export LC_ALL
+
 # Get the execution path to this script and the current directory.
 
 mypath=${0-.}
