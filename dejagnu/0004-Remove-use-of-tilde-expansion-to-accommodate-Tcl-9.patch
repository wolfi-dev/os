From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jacob Bachmeyer <jcb@gnu.org>
Date: Wed, 20 May 2026 19:44:19 -0500
Subject: [PATCH 4/5] Remove use of tilde expansion to accommodate Tcl 9

Tilde expansion in ordinary file operations was removed in Tcl 9,
per TIP 602, due to the risks of unexpected behavior it presented.

(cherry picked from commit f8737d9707b00069f35565d65b156a6567ab50a5, ChangeLog hunk dropped)
---
 runtest.exp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/runtest.exp b/runtest.exp
index 01abaf1..e03c4fc 100644
--- a/runtest.exp
+++ b/runtest.exp
@@ -306,8 +306,9 @@ proc load_file { args } {
     set found 0
     foreach file [lrange $args $i end] {
 	verbose "Looking for $file" 2
-	# In Tcl, "file exists" fails if the filename looks like
+	# In Tcl 8, "file exists" fails if the filename looks like
 	# ~/FILE and the environment variable HOME does not exist.
+	# In Tcl 9, this tilde expansion no longer exists.
 	if {! [catch {file exists $file} result] && $result} {
 	    set found 1
 	    verbose "Found $file"
@@ -1041,7 +1042,7 @@ if {[info exists env(DEJAGNU)]} {
 }
 
 # Load user .dejagnurc file last as the ultimate override.
-load_file ~/.dejagnurc
+load_file [file join $env(HOME) .dejagnurc]
 
 if {![info exists boards_dir]} {
     set boards_dir ""
