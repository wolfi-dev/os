From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jacob Bachmeyer <jcb@gnu.org>
Date: Thu, 21 May 2026 20:58:59 -0500
Subject: [PATCH 5/5] Avoid error if HOME is not set in the environment

(cherry picked from commit df37452fa640af0479c1533fd81c7235a92da2ff, ChangeLog hunk dropped)
---
 runtest.exp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/runtest.exp b/runtest.exp
index e03c4fc..e4213a3 100644
--- a/runtest.exp
+++ b/runtest.exp
@@ -1042,7 +1042,9 @@ if {[info exists env(DEJAGNU)]} {
 }
 
 # Load user .dejagnurc file last as the ultimate override.
-load_file [file join $env(HOME) .dejagnurc]
+if { [info exists env(HOME)] } {
+    load_file [file join $env(HOME) .dejagnurc]
+}
 
 if {![info exists boards_dir]} {
     set boards_dir ""
