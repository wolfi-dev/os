From f4aaf98d56dc4784180e3b88f3b17d75d3d80d07 Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Sun, 11 Oct 2026 12:51:13 +0100
Subject: [PATCH 10/11] Prefer OpenSSL 4 over OpenSSL 3 in the portable OpenSSL
 shim

Probe libssl.so.4 first, ahead of libssl.so.3, instead of only as the
last fallback. DOTNET_OPENSSL_VERSION_OVERRIDE still takes precedence.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../opensslshim.c                                   | 13 ++++++-------
 1 file changed, 6 insertions(+), 7 deletions(-)

diff --git a/src/runtime/src/native/libs/System.Security.Cryptography.Native/opensslshim.c b/src/runtime/src/native/libs/System.Security.Cryptography.Native/opensslshim.c
index 3df050a1d8..c865906469 100644
--- a/src/runtime/src/native/libs/System.Security.Cryptography.Native/opensslshim.c
+++ b/src/runtime/src/native/libs/System.Security.Cryptography.Native/opensslshim.c
@@ -95,7 +95,12 @@ static void OpenLibraryOnce(void)
 
     if (libssl == NULL)
     {
-        // Prefer OpenSSL 3.x
+        // Prefer OpenSSL 4.x
+        DlOpen(MAKELIB("4"));
+    }
+
+    if (libssl == NULL)
+    {
         DlOpen(MAKELIB("3"));
     }
 
@@ -129,12 +134,6 @@ static void OpenLibraryOnce(void)
         DlOpen(MAKELIB("111"));
     }
 #endif
-
-    // While it's still in alpha, OpenSSL 4 is probed, but not preferred.
-    if (libssl == NULL)
-    {
-        DlOpen(MAKELIB("4"));
-    }
 }
 
 static pthread_once_t g_openLibrary = PTHREAD_ONCE_INIT;
-- 
