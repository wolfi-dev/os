From 75b456de8258e0ea087438943dd7b7eda2e9c15b Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Sun, 11 Oct 2026 15:06:17 +0100
Subject: [PATCH 11/11] Add DistroAgnosticOpenSsl option to build the runtime
 with the OpenSSL shim

When /p:DistroAgnosticOpenSsl=true is passed, add
-DFEATURE_DISTRO_AGNOSTIC_SSL=1 to the runtime's CMake args so that
OpenSSL is loaded via dlopen (opensslshim) even in non-portable
source-only builds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 repo-projects/runtime.proj | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/repo-projects/runtime.proj b/repo-projects/runtime.proj
index 28942980b4..2eac50bb90 100644
--- a/repo-projects/runtime.proj
+++ b/repo-projects/runtime.proj
@@ -60,6 +60,9 @@
     <BuildArgs Condition="$(UseSystemLibs.Contains('+rapidjson')) or $(UseSystemLibs.Contains('+all'))">$(BuildArgs) --cmakeargs -DCLR_CMAKE_USE_SYSTEM_RAPIDJSON=true</BuildArgs>
     <BuildArgs Condition="$(UseSystemLibs.Contains('+zlib')) or $(UseSystemLibs.Contains('+all'))">$(BuildArgs) --cmakeargs -DCLR_CMAKE_USE_SYSTEM_ZLIB=true</BuildArgs>
     <BuildArgs Condition="$(UseSystemLibs.Contains('-lttng'))">$(BuildArgs) /p:FeatureXplatEventSource=false</BuildArgs>
+
+    <!-- Load OpenSSL via dlopen (opensslshim) even in a non-portable build. -->
+    <BuildArgs Condition="'$(DistroAgnosticOpenSsl)' == 'true'">$(BuildArgs) --cmakeargs -DFEATURE_DISTRO_AGNOSTIC_SSL=1</BuildArgs>
   </PropertyGroup>
 
   <ItemGroup>
