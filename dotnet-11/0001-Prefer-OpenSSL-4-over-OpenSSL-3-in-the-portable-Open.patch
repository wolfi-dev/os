From 55dd1f4b13e3a3f7e36043853528905a33c3126c Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Fri, 6 Nov 2026 04:39:04 +0000
Subject: [PATCH 1/2] Prefer OpenSSL 4 over OpenSSL 3 in the portable OpenSSL
 shim

Probe libssl.so.4 first, ahead of libssl.so.3, instead of only as the
last fallback. DOTNET_OPENSSL_VERSION_OVERRIDE still takes precedence.

Ported to 11.0 from dotnet-10's patch of the same name: the 11.0 shim
probes the FreeBSD and OpenBSD library names in their own blocks ahead of
the generic ones, which is where this change applies.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../System.Security.Cryptography.Native/opensslshim.c    | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/src/runtime/src/native/libs/System.Security.Cryptography.Native/opensslshim.c b/src/runtime/src/native/libs/System.Security.Cryptography.Native/opensslshim.c
index 594735ac7..8431fee22 100644
--- a/src/runtime/src/native/libs/System.Security.Cryptography.Native/opensslshim.c
+++ b/src/runtime/src/native/libs/System.Security.Cryptography.Native/opensslshim.c
@@ -227,19 +227,18 @@ static void OpenLibraryOnce(void)
 
     if (libssl == NULL)
     {
-        // Prefer OpenSSL 3.x
-        DlOpen(MAKELIB("3"));
+        // Prefer OpenSSL 4.x
+        DlOpen(MAKELIB("4"));
     }
 
     if (libssl == NULL)
     {
-        DlOpen(MAKELIB("1.1"));
+        DlOpen(MAKELIB("3"));
     }
 
-    // While it's still in alpha, OpenSSL 4 is probed, but not preferred.
     if (libssl == NULL)
     {
-        DlOpen(MAKELIB("4"));
+        DlOpen(MAKELIB("1.1"));
     }
 }
 
