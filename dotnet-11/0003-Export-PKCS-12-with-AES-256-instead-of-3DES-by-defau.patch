From 6a824f2785b7cf2ef8ab05bdffd099997bb9a4f6 Mon Sep 17 00:00:00 2001
From: Sergio Durigan Junior <sergiodj@chainguard.dev>
Date: Thu, 12 Nov 2026 11:49:34 -0500
Subject: [PATCH 3/3] Export PKCS#12 with AES-256 instead of 3DES by default

X509Certificate.Export and X509Certificate2Collection.Export with
X509ContentType.Pfx (or Pkcs12, the same value) encrypt the certificates
and keys with pbeWithSHA1And3-KeyTripleDES-CBC and seal the file with an
HMAC-SHA1 MAC. Chainguard's OpenSSL does not offer Triple DES by default,
so that export fails with "error:0308010C:digital envelope
routines::unsupported", and so does every caller of it, such as
"dotnet dev-certs https".

Export with Helpers.WindowsAesPbe instead: PBES2 with PBKDF2,
HMAC-SHA256 and AES-256-CBC, 2000 iterations, and an HMAC-SHA256 MAC.
Pkcs12ExportPbeParameters.Default already maps to these parameters, and
the X509Store has written its files with AES-256 since .NET 10
(dotnet/runtime#112749). A caller that needs a Triple DES file still
asks for one with
ExportPkcs12(Pkcs12ExportPbeParameters.Pkcs12TripleDesSha1, ...).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Cryptography/X509Certificates/UnixExportProvider.cs      | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/runtime/src/libraries/System.Security.Cryptography/src/System/Security/Cryptography/X509Certificates/UnixExportProvider.cs b/src/runtime/src/libraries/System.Security.Cryptography/src/System/Security/Cryptography/X509Certificates/UnixExportProvider.cs
index 1dfb8e5..3a3c680 100644
--- a/src/runtime/src/libraries/System.Security.Cryptography/src/System/Security/Cryptography/X509Certificates/UnixExportProvider.cs
+++ b/src/runtime/src/libraries/System.Security.Cryptography/src/System/Security/Cryptography/X509Certificates/UnixExportProvider.cs
@@ -50,7 +50,10 @@ namespace System.Security.Cryptography.X509Certificates
                 case X509ContentType.Cert:
                     return ExportX509Der();
                 case X509ContentType.Pfx:
-                    return ExportPkcs12(Helpers.Windows3desPbe, password);
+                    // Chainguard: PBES2 with AES-256 and SHA-256, the parameters
+                    // Pkcs12ExportPbeParameters.Default maps to, instead of 3DES-SHA1,
+                    // which Chainguard's OpenSSL does not offer by default.
+                    return ExportPkcs12(Helpers.WindowsAesPbe, password);
                 case X509ContentType.Pkcs7:
                     return ExportPkcs7();
                 case X509ContentType.SerializedCert:
