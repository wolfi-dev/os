From 7a805900b111db25ff0c36bc59e1eb0fc71c6b14 Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Tue, 8 Sep 2026 20:43:45 +0000
Subject: [PATCH 9/9] Shim CRYPTO_zalloc for OPENSSL_zalloc callers

The backport of "Prefer using non-deprecated EC OSSL APIs where possible"
(#127190) introduced OPENSSL_zalloc calls in pal_ecc_import_export.c, which
expand to CRYPTO_zalloc. On main this symbol was added to the shim by
f21b9454aa3 ("Support EVP_MAC for HMAC"), which is not on release/10.0.
Add only the shim entries for it so the portable build links.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../libs/System.Security.Cryptography.Native/opensslshim.h      | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/native/libs/System.Security.Cryptography.Native/opensslshim.h b/src/native/libs/System.Security.Cryptography.Native/opensslshim.h
index 40503e914a8..a5610b8f073 100644
--- a/src/native/libs/System.Security.Cryptography.Native/opensslshim.h
+++ b/src/native/libs/System.Security.Cryptography.Native/opensslshim.h
@@ -379,6 +379,7 @@ extern bool g_libSslUses32BitTime;
     REQUIRED_FUNCTION(CRYPTO_get_ex_new_index) \
     REQUIRED_FUNCTION(CRYPTO_malloc) \
     REQUIRED_FUNCTION(CRYPTO_set_mem_functions) \
+    REQUIRED_FUNCTION(CRYPTO_zalloc) \
     REQUIRED_FUNCTION(d2i_OCSP_RESPONSE) \
     REQUIRED_FUNCTION(d2i_PKCS12_fp) \
     REQUIRED_FUNCTION(d2i_PKCS7) \
@@ -943,6 +944,7 @@ extern TYPEOF(OPENSSL_gmtime)* OPENSSL_gmtime_ptr;
 #define CRYPTO_get_ex_new_index CRYPTO_get_ex_new_index_ptr
 #define CRYPTO_malloc CRYPTO_malloc_ptr
 #define CRYPTO_set_mem_functions CRYPTO_set_mem_functions_ptr
+#define CRYPTO_zalloc CRYPTO_zalloc_ptr
 #define d2i_OCSP_RESPONSE d2i_OCSP_RESPONSE_ptr
 #define d2i_PKCS12_fp d2i_PKCS12_fp_ptr
 #define d2i_PKCS7 d2i_PKCS7_ptr
-- 
