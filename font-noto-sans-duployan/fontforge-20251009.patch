+def _layer_to_data(layer):
+    return {'q': bool(layer.is_quadratic),
+            'c': [{'closed': bool(c.closed), 'p': [(pt.x, pt.y, bool(pt.on_curve)) for pt in c]} for c in layer]}
+
+
+def _layer_from_data(data):
+    layer = fontforge.layer()
+    layer.is_quadratic = data['q']
+    for c in data['c']:
+        contour = fontforge.contour()
+        contour.is_quadratic = data['q']
+        for x, y, on in c['p']:
+            contour += fontforge.point(x, y, on)
+        contour.closed = c['closed']
+        layer += contour
+    return layer
+
+
+def _guarded(fn, layer):
+    """Runs `fn(layer)` in a forked child and returns the resulting layer, or
+    None if the child died (a segfault in FontForge's overlap removal,
+    fontforge/fontforge#5357). The child serialises the layer's points back
+    over a pipe; nothing else in the process is affected."""
+    import json
+    import os
+    import sys
+    sys.stdout.flush()
+    sys.stderr.flush()
+    import traceback
+    r, w = os.pipe()
+    pid = os.fork()
+    if pid == 0:
+        os.close(r)
+        code = 0
+        try:
+            fn(layer)
+            payload = json.dumps(_layer_to_data(layer)).encode()
+        except BaseException:
+            # A Python error in the generator is not a FontForge crash: pass
+            # it to the parent so the build fails the way it always did.
+            payload = b'EXC\n' + traceback.format_exc().encode()
+            code = 2
+        view = memoryview(payload)
+        while view:
+            n = os.write(w, view)
+            view = view[n:]
+        os.close(w)
+        os._exit(code)
+    os.close(w)
+    chunks = []
+    while True:
+        chunk = os.read(r, 1 << 16)
+        if not chunk:
+            break
+        chunks.append(chunk)
+    os.close(r)
+    _, status = os.waitpid(pid, 0)
+    data = b''.join(chunks)
+    if data.startswith(b'EXC\n'):
+        raise RuntimeError('error in forked FontForge call:\n' + data[4:].decode(errors='replace'))
+    if os.WIFSIGNALED(status) or status != 0 or not data:
+        # The child died (a FontForge segfault) or could not report.
+        return None
+    return _layer_from_data(json.loads(data))
+
+
+def _stroke_guarded(layer, args, kwargs):
+    """Strokes a copy of `layer` in a child; None if FontForge crashed."""
+    return _guarded(lambda l: l.stroke(*args, **kwargs), layer.dup())
+
+
+def _remove_overlap_guarded(layer):
+    return _guarded(lambda l: l.removeOverlap(), layer.dup())
+
+
+def _log_stroke_event(record):
+    import json
+    import os
+    if path := os.environ.get('DUPLOYAN_STROKE_LOG'):
+        with open(path, 'a') as f:
+            f.write(json.dumps(record) + '\n')
+
+
+def _has_open_contour(layer):
+    return any(len(contour) and not contour.closed for contour in layer)
+
+
+def _split_zero_length(layer):
+    """Separates zero-length contours (all points coincident) from the rest."""
+    kept = fontforge.layer()
+    kept.is_quadratic = layer.is_quadratic
+    centers = []
+    for contour in layer:
+        points = [(point.x, point.y) for point in contour]
+        if points and all(abs(x - points[0][0]) < 1e-6 and abs(y - points[0][1]) < 1e-6 for x, y in points):
+            centers.append(points[0])
+        else:
+            kept += contour
+    return kept, centers
+
+
+def _circle(cx, cy, r):
+    """A clockwise (FontForge outer-contour direction) cubic circle."""
+    k = 0.5522847498307936 * r
+    contour = fontforge.contour()
+    contour.moveTo(cx + r, cy)
+    contour.cubicTo((cx + r, cy - k), (cx + k, cy - r), (cx, cy - r))
+    contour.cubicTo((cx - k, cy - r), (cx - r, cy - k), (cx - r, cy))
+    contour.cubicTo((cx - r, cy + k), (cx - k, cy + r), (cx, cy + r))
+    contour.cubicTo((cx + k, cy + r), (cx + r, cy + k), (cx + r, cy))
+    contour.closed = True
+    if contour.isClockwise() == 0:
+        contour.reverseDirection()
+    return contour
+
+
+def _stroke_layer(layer, args, kwargs):
+    """Strokes `layer` the way FontForge 2019 did, on FontForge 20200314 and later.
+
+    Zero-length contours become explicit circles (the old stroker's round cap);
+    the rest is stroked on the exact input first and, if the result has an open
+    contour, again on copies rounded to 1/1000, 1/100, 1/10 and 1 unit.
+    """
+    nib = args[0]
+    kept, centers = _split_zero_length(layer)
+    cap = args[2] if len(args) > 2 else kwargs.get('cap', 'nib')
+    if centers and not (nib == 'circular' and cap == 'round'):
+        _log_stroke_event({'zero_length_dropped': len(centers), 'args': [repr(a) for a in args]})
+        centers = []
+    original = kept.dup()
+    result = kept
+    if len(kept):
+        # Every stroke runs in a forked child (see _guarded): FontForge's
+        # overlap removal inside stroke() segfaults on some inputs
+        # (fontforge/fontforge#5357), and which inputs differs by
+        # architecture (x86_64 and aarch64 round floating point differently),
+        # so the crash can be neither predicted nor caught in-process.
+        # Rounded and nudged copies are tried in turn until one survives and
+        # comes back without an open contour (fontforge/fontforge#4490).
+        attempts = [('round', 1000), ('round', 100), ('round', 10), ('round', 1), ('nudge', 0.0007)]
+        result = None
+        first_closed = None
+        for i, (how, value) in enumerate(attempts):
+            candidate = original.dup()
+            if how == 'round':
+                candidate.round(value)
+            else:
+                candidate.transform((1, 0, 0, 1, value, value / 2))
+            stroked = _stroke_guarded(candidate, args, kwargs)
+            if stroked is None:
+                _log_stroke_event({'args': [repr(a) for a in args], 'points': sum(len(c) for c in original), 'crashed_at': [how, value]})
+                continue
+            if how == 'nudge':
+                stroked.transform((1, 0, 0, 1, -value, -value / 2))
+            if not _has_open_contour(stroked):
+                if i:
+                    _log_stroke_event({'args': [repr(a) for a in args], 'points': sum(len(c) for c in original), 'fixed_by': [how, value]})
+                result = stroked
+                break
+            if first_closed is None:
+                first_closed = stroked
+        if result is None:
+            if first_closed is None:
+                # Every attempt crashed FontForge. Shipping the unstroked
+                # path would silently lose the stroke; stop the build.
+                raise RuntimeError(
+                    f'FontForge crashed in stroke{args} on every attempt (rounded to 1/1000, 1/100, 1/10, 1 unit and nudged); input: '
+                    f'{[[(pt.x, pt.y, bool(pt.on_curve)) for pt in c] for c in original]}')
+            # Every survivor had an open contour: keep the first (its open
+            # leftovers are dropped later, as the generator always did).
+            _log_stroke_event({'args': [repr(a) for a in args], 'points': sum(len(c) for c in original), 'fixed_by': None})
+            result = first_closed
+    for cx, cy in centers:
+        result += _circle(cx, cy, args[1] / 2)
+        _log_stroke_event({'dot': (cx, cy), 'diameter': args[1]})
+    return result
+
+
+def _round_and_stroke(glyph, *args, **kwargs):
+    """Rounds the glyph to 1/1000 unit (fontforge/fontforge#5357), then strokes it via _stroke_layer."""
+    if hasattr(glyph, 'foreground'):
+        layer = glyph.foreground
+        layer.round(1000)
+        glyph.foreground = _stroke_layer(layer, args, kwargs)
+    else:
+        glyph.stroke(*args, **kwargs)
+
+
+def _remove_overlap_closed(glyph):
+    """`glyph.removeOverlap()` that never answers with an open contour.
+
+    FontForge 20251009 turns some sets of overlapping closed contours into one
+    open contour (the stenographic period's four round-capped strokes through
+    the origin). Retry on rounded copies; if nothing closes, keep the overlapping
+    contours rather than lose the glyph.
+    """
+    if not hasattr(glyph, 'foreground'):
+        glyph.removeOverlap()
+        return
+    original = glyph.foreground.dup()
+    layer = glyph.foreground
+    layer.round(1000)
+    removed = _remove_overlap_guarded(layer)
+    crashed = removed is None
+    if crashed:
+        _log_stroke_event({'overlap': glyph.glyphname, 'crashed_at': 1000})
+    else:
+        glyph.foreground = removed
+        if not _has_open_contour(removed):
+            return
+
+    def degenerate(layer):
+        # Open leftovers of one or two points carry no area; dropping them is
+        # what _remove_bad_contours does. An open contour with more points is
+        # a real outline that failed to close.
+        return all(contour.closed or len(contour) <= 2 for contour in layer)
+
+    def without_degenerate(layer):
+        cleaned = fontforge.layer()
+        cleaned.is_quadratic = layer.is_quadratic
+        for contour in layer:
+            if contour.closed:
+                cleaned += contour
+        return cleaned
+
+    if not crashed and degenerate(glyph.foreground):
+        _log_stroke_event({'overlap': glyph.glyphname, 'dropped_degenerate': sum(1 for c in glyph.foreground if not c.closed)})
+        glyph.foreground = without_degenerate(glyph.foreground)
+        return
+    for factor in (100, 10, 1):
+        retry = original.dup()
+        retry.round(factor)
+        retry = _remove_overlap_guarded(retry)
+        if retry is None:
+            _log_stroke_event({'overlap': glyph.glyphname, 'crashed_at': factor})
+            continue
+        if not _has_open_contour(retry):
+            _log_stroke_event({'overlap': glyph.glyphname, 'fixed_by': factor})
+            glyph.foreground = retry
+            return
+        if degenerate(retry):
+            _log_stroke_event({'overlap': glyph.glyphname, 'fixed_by': factor, 'dropped_degenerate': sum(1 for c in retry if not c.closed)})
+            glyph.foreground = without_degenerate(retry)
+            return
+    if crashed:
+        # Every rung crashed: keep the overlapping contours rather than lose
+        # the glyph, and say so.
+        _log_stroke_event({'overlap': glyph.glyphname, 'fixed_by': None, 'all_crashed': True})
+        import sys
+        print(f'warning: FontForge crashed in removeOverlap of {glyph.glyphname} on every attempt; overlaps left in place', file=sys.stderr)
+    else:
+        _log_stroke_event({'overlap': glyph.glyphname, 'fixed_by': None,
+                           'open_sizes': [len(c) for c in glyph.foreground if not c.closed], 'closed': sum(1 for c in glyph.foreground if c.closed)})
+    glyph.foreground = original
+
