+++ b/gcc/gengtype-lex.l
@@ -202,7 +202,7 @@ CXX_KEYWORD inline|public:|private:|protected:|template|operator|friend|static|m
 %%
 
 void
-yybegin (const char *fname)
+gengtype_yybegin (const char *fname)
 {
   yyin = fopen (fname, "r");
   if (yyin == NULL)
diff --git a/gcc/gengtype-parse.c b/gcc/gengtype-parse.c
index 8ec83ce..593ad50 100644
--- a/gcc/gengtype-parse.c
+++ b/gcc/gengtype-parse.c
@@ -1144,7 +1144,7 @@ extern_or_static (void)
 void
 parse_file (const char *fname)
 {
-  yybegin (fname);
+  gengtype_yybegin (fname);
   for (;;)
     {
       switch (token ())
diff --git a/gcc/gengtype.h b/gcc/gengtype.h
index 4fe8f0f..148d098 100644
--- a/gcc/gengtype.h
+++ b/gcc/gengtype.h
@@ -441,7 +441,7 @@ extern void note_variable (const char *s, type_p t, options_p o,
 
