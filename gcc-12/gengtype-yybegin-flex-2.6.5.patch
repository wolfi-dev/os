+++ b/gcc/gengtype-lex.l
@@ -202,7 +202,7 @@ CXX_KEYWORD inline|public:|private:|protected:|template|operator|friend|static|m
 %%
 
 void
-yybegin (const char *fname)
+gengtype_yybegin (const char *fname)
 {
   yyin = fopen (fname, "r");
   if (yyin == NULL)
diff --git a/gcc/gengtype-parse.cc b/gcc/gengtype-parse.cc
index 1223ad0..06ca1f1 100644
--- a/gcc/gengtype-parse.cc
+++ b/gcc/gengtype-parse.cc
@@ -1144,7 +1144,7 @@ extern_or_static (void)
 void
 parse_file (const char *fname)
 {
-  yybegin (fname);
+  gengtype_yybegin (fname);
   for (;;)
     {
       switch (token ())
diff --git a/gcc/gengtype.h b/gcc/gengtype.h
index 76c1fe6..3d95004 100644
--- a/gcc/gengtype.h
+++ b/gcc/gengtype.h
@@ -452,7 +452,7 @@ extern void note_variable (const char *s, type_p t, options_p o,
 
 /* Lexer and parser routines.  */
