+/**
+ * Whether fName names the allocator shim `shim`. rustc 1.9x mangles the
+ * shims under its v0 scheme, as items of a `__rustc` crate: `__rust_alloc`
+ * is `_RNvCs<hash>_7___rustc12___rust_alloc`, and the hash changes with
+ * every rustc build.
+ */
+static auto isAllocShim(const std::string &fName, const std::string &shim) -> bool
+{
+	if (fName == shim)
+		return true;
+	const std::string suffix = "_7___rustc" + std::to_string(shim.size()) + "_" + shim;
+	return fName.starts_with("_RNvCs") && fName.ends_with(suffix);
+}
