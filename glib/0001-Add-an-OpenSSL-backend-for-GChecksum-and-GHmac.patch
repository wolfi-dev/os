diff --git a/glib/ghmac-openssl.c b/glib/ghmac-openssl.c
new file mode 100644
index 0000000..b2eeee0
--- /dev/null
+++ b/glib/ghmac-openssl.c
@@ -0,0 +1,255 @@
+/* ghmac-openssl.c - GHmac backed by OpenSSL libcrypto
+ *
+ * Copyright (C) 2026 Chainguard, Inc.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this library; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/* The public functions here are documented in ghmac.c. The HMAC itself is
+ * computed by the "HMAC" EVP_MAC of the default library context, not built
+ * on top of GChecksum, so that the keyed construction also runs inside the
+ * configured (e.g. FIPS) provider. g_hmac_new() returns %NULL when the
+ * provider rejects the digest or the key, for instance MD5, or keys
+ * shorter than 112 bits when the FIPS provider enforces its key check. */
+
+#include "config.h"
+
+#include <string.h>
+
+#include "ghmac.h"
+
+#include "gatomic.h"
+#include "gchecksumprivate.h"
+#include "gmem.h"
+#include "gmessages.h"
+#include "gopensslprivate.h"
+#include "gstrfuncs.h"
+#include "gtestutils.h"
+
+struct _GHmac
+{
+  int ref_count;
+  GChecksumType digest_type;
+  EVP_MAC_CTX *ctx;
+  gboolean closed;
+  guint8 digest[EVP_MAX_MD_SIZE];
+  gchar *digest_str;
+};
+
+GHmac *
+g_hmac_new (GChecksumType  digest_type,
+            const guchar  *key,
+            gsize          key_len)
+{
+  static const guchar empty_key[1] = { 0 };
+  const GOpenSSLFuncs *funcs;
+  OSSL_PARAM params[2];
+  const char *name;
+  EVP_MAC *mac;
+  GHmac *hmac;
+
+  g_return_val_if_fail (key_len <= G_MAXSSIZE, NULL);
+  g_return_val_if_fail (key_len == 0 || key != NULL, NULL);
+
+  name = g_openssl_digest_name (digest_type);
+  g_return_val_if_fail (name != NULL, NULL);
+
+  funcs = g_openssl_get_funcs ();
+
+  mac = funcs->EVP_MAC_fetch (NULL, "HMAC", NULL);
+  if (mac == NULL)
+    {
+      gchar *err = g_openssl_take_error (funcs);
+      g_warning ("GHmac: HMAC is not available: %s", err);
+      g_free (err);
+      return NULL;
+    }
+
+  hmac = g_new0 (GHmac, 1);
+  hmac->ref_count = 1;
+  hmac->digest_type = digest_type;
+  hmac->ctx = funcs->EVP_MAC_CTX_new (mac);
+  funcs->EVP_MAC_free (mac);  /* the context holds its own reference */
+  if (hmac->ctx == NULL)
+    g_error ("GHmac: EVP_MAC_CTX_new failed");
+
+  params[0] = funcs->OSSL_PARAM_construct_utf8_string (OSSL_MAC_PARAM_DIGEST,
+                                                     (char *) name, 0);
+  params[1] = funcs->OSSL_PARAM_construct_end ();
+
+  /* A NULL key tells EVP_MAC_init() to reuse a previous key, so an empty
+   * key must still be passed as a non-NULL pointer. */
+  if (!funcs->EVP_MAC_init (hmac->ctx, key_len > 0 ? key : empty_key,
+                            key_len, params))
+    {
+      gchar *err = g_openssl_take_error (funcs);
+      g_warning ("GHmac: HMAC-%s is not available: %s", name, err);
+      g_free (err);
+      funcs->EVP_MAC_CTX_free (hmac->ctx);
+      g_free (hmac);
+      return NULL;
+    }
+
+  return hmac;
+}
+
+GHmac *
+g_hmac_copy (const GHmac *hmac)
+{
+  const GOpenSSLFuncs *funcs;
+  GHmac *copy;
+
+  g_return_val_if_fail (hmac != NULL, NULL);
+
+  funcs = g_openssl_get_funcs ();
+
+  copy = g_new0 (GHmac, 1);
+  copy->ref_count = 1;
+  copy->digest_type = hmac->digest_type;
+  copy->closed = hmac->closed;
+  memcpy (copy->digest, hmac->digest, sizeof (copy->digest));
+  copy->digest_str = g_strdup (hmac->digest_str);
+
+  /* g_hmac_copy() cannot fail. */
+  copy->ctx = funcs->EVP_MAC_CTX_dup (hmac->ctx);
+  if (copy->ctx == NULL)
+    {
+      gchar *err = g_openssl_take_error (funcs);
+      g_error ("GHmac: EVP_MAC_CTX_dup failed: %s", err);
+    }
+
+  return copy;
+}
+
+GHmac *
+g_hmac_ref (GHmac *hmac)
+{
+  g_return_val_if_fail (hmac != NULL, NULL);
+
+  g_atomic_int_inc (&hmac->ref_count);
+
+  return hmac;
+}
+
+void
+g_hmac_unref (GHmac *hmac)
+{
+  g_return_if_fail (hmac != NULL);
+
+  if (g_atomic_int_dec_and_test (&hmac->ref_count))
+    {
+      g_openssl_get_funcs ()->EVP_MAC_CTX_free (hmac->ctx);
+      g_free (hmac->digest_str);
+      g_free (hmac);
+    }
+}
+
+void
+g_hmac_update (GHmac        *hmac,
+               const guchar *data,
+               gssize        length)
+{
+  const GOpenSSLFuncs *funcs;
+  size_t unsigned_length;
+
+  g_return_if_fail (hmac != NULL);
+  g_return_if_fail (length == 0 || data != NULL);
+
+  if (hmac->closed)
+    {
+      g_warning ("The HMAC has been closed and cannot be updated any more.");
+      return;
+    }
+
+  if (length < 0)
+    unsigned_length = strlen ((const gchar *) data);
+  else
+    unsigned_length = (size_t) length;
+
+  if (unsigned_length == 0)
+    return;
+
+  funcs = g_openssl_get_funcs ();
+
+  /* g_hmac_update() cannot fail, and carrying on would return a wrong
+   * digest later, so a libcrypto failure here is fatal. */
+  if (!funcs->EVP_MAC_update (hmac->ctx, data, unsigned_length))
+    {
+      gchar *err = g_openssl_take_error (funcs);
+      g_error ("GHmac: EVP_MAC_update failed: %s", err);
+    }
+}
+
+static void
+hmac_close (GHmac *hmac)
+{
+  const GOpenSSLFuncs *funcs;
+  size_t len = 0;
+
+  if (hmac->closed)
+    return;
+
+  funcs = g_openssl_get_funcs ();
+
+  if (!funcs->EVP_MAC_final (hmac->ctx, hmac->digest, &len,
+                             sizeof (hmac->digest)))
+    {
+      gchar *err = g_openssl_take_error (funcs);
+      g_error ("GHmac: EVP_MAC_final failed: %s", err);
+    }
+
+  g_assert ((gssize) len == g_checksum_type_get_length (hmac->digest_type));
+
+  hmac->closed = TRUE;
+}
+
+const gchar *
+g_hmac_get_string (GHmac *hmac)
+{
+  g_return_val_if_fail (hmac != NULL, NULL);
+
+  if (hmac->digest_str == NULL)
+    {
+      hmac_close (hmac);
+      hmac->digest_str = gchecksum_digest_to_string (
+          hmac->digest, (gsize) g_checksum_type_get_length (hmac->digest_type));
+    }
+
+  return hmac->digest_str;
+}
+
+void
+g_hmac_get_digest (GHmac  *hmac,
+                   guint8 *buffer,
+                   gsize  *digest_len)
+{
+  gssize len_signed;
+  gsize len;
+
+  g_return_if_fail (hmac != NULL);
+
+  len_signed = g_checksum_type_get_length (hmac->digest_type);
+  g_assert (len_signed >= 0);
+  len = (gsize) len_signed;
+
+  /* @buffer must be long enough for the digest */
+  g_return_if_fail (*digest_len >= len);
+
+  hmac_close (hmac);
+
+  memcpy (buffer, hmac->digest, len);
+  *digest_len = len;
+}
diff --git a/glib/ghmac.c b/glib/ghmac.c
index 97e2fff..f755b11 100644
--- a/glib/ghmac.c
+++ b/glib/ghmac.c
@@ -58,6 +58,8 @@
  * Since: 2.30
  */
 
+#ifndef USE_OPENSSL
+/* Built-in implementation; ghmac-openssl.c replaces it with -Dopenssl. */
 struct _GHmac
 {
   int ref_count;
