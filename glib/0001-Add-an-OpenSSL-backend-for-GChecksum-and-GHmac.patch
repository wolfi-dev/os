diff --git a/glib/gchecksum-openssl.c b/glib/gchecksum-openssl.c
new file mode 100644
index 0000000..5efd877
--- /dev/null
+++ b/glib/gchecksum-openssl.c
@@ -0,0 +1,261 @@
+/* gchecksum-openssl.c - GChecksum backed by OpenSSL libcrypto
+ *
+ * Copyright (C) 2026 Chainguard, Inc.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this library; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/* The public functions here are documented in gchecksum.c. Digests are
+ * fetched from the default library context, so the process-wide OpenSSL
+ * configuration (providers, default_properties such as "fips=yes") decides
+ * which implementation is used and which algorithms are available. In
+ * particular g_checksum_new() returns %NULL for %G_CHECKSUM_MD5 when no
+ * loaded provider offers it under the configured properties. */
+
+#include "config.h"
+
+#include <string.h>
+
+#include "gchecksumprivate.h"
+#include "gopensslprivate.h"
+
+#include "gmem.h"
+#include "gmessages.h"
+#include "gstrfuncs.h"
+#include "gtestutils.h"
+
+struct _GChecksum
+{
+  GChecksumType type;
+
+  /* Set once the checksum is closed, as in the built-in implementation. */
+  gchar *digest_str;
+
+  EVP_MD *md;
+  EVP_MD_CTX *ctx;
+  guint8 digest[EVP_MAX_MD_SIZE];
+};
+
+static void
+checksum_init (const GOpenSSLFuncs *funcs,
+               GChecksum           *checksum)
+{
+  if (!funcs->EVP_DigestInit_ex2 (checksum->ctx, checksum->md, NULL))
+    {
+      gchar *err = g_openssl_take_error (funcs);
+      g_error ("GChecksum: EVP_DigestInit_ex2 failed: %s", err);
+    }
+}
+
+GChecksum *
+g_checksum_new (GChecksumType checksum_type)
+{
+  const GOpenSSLFuncs *funcs;
+  const char *name;
+  GChecksum *checksum;
+  EVP_MD *md;
+
+  name = g_openssl_digest_name (checksum_type);
+  if (name == NULL)
+    return NULL;
+
+  funcs = g_openssl_get_funcs ();
+
+  md = funcs->EVP_MD_fetch (NULL, name, NULL);
+  if (md == NULL)
+    {
+      gchar *err = g_openssl_take_error (funcs);
+      g_warning ("GChecksum: %s is not available: %s", name, err);
+      g_free (err);
+      return NULL;
+    }
+
+  checksum = g_new0 (GChecksum, 1);
+  checksum->type = checksum_type;
+  checksum->md = md;
+  checksum->ctx = funcs->EVP_MD_CTX_new ();
+  if (checksum->ctx == NULL)
+    g_error ("GChecksum: EVP_MD_CTX_new failed");
+
+  checksum_init (funcs, checksum);
+
+  return checksum;
+}
+
+void
+g_checksum_reset (GChecksum *checksum)
+{
+  g_return_if_fail (checksum != NULL);
+
+  g_free (checksum->digest_str);
+  checksum->digest_str = NULL;
+
+  checksum_init (g_openssl_get_funcs (), checksum);
+}
+
+GChecksum *
+g_checksum_copy (const GChecksum *checksum)
+{
+  const GOpenSSLFuncs *funcs;
+  GChecksum *copy;
+
+  g_return_val_if_fail (checksum != NULL, NULL);
+
+  funcs = g_openssl_get_funcs ();
+
+  copy = g_new0 (GChecksum, 1);
+  copy->type = checksum->type;
+  copy->digest_str = g_strdup (checksum->digest_str);
+  memcpy (copy->digest, checksum->digest, sizeof (copy->digest));
+
+  if (!funcs->EVP_MD_up_ref (checksum->md))
+    g_error ("GChecksum: EVP_MD_up_ref failed");
+  copy->md = checksum->md;
+
+  /* A finalised context cannot be duplicated meaningfully; a closed copy
+   * only needs a context that g_checksum_reset() can initialise. */
+  if (checksum->digest_str != NULL)
+    copy->ctx = funcs->EVP_MD_CTX_new ();
+  else
+    copy->ctx = funcs->EVP_MD_CTX_dup (checksum->ctx);
+
+  if (copy->ctx == NULL)
+    {
+      gchar *err = g_openssl_take_error (funcs);
+      g_error ("GChecksum: copying the digest context failed: %s", err);
+    }
+
+  return copy;
+}
+
+void
+g_checksum_free (GChecksum *checksum)
+{
+  const GOpenSSLFuncs *funcs;
+
+  if (G_UNLIKELY (checksum == NULL))
+    return;
+
+  funcs = g_openssl_get_funcs ();
+
+  funcs->EVP_MD_CTX_free (checksum->ctx);
+  funcs->EVP_MD_free (checksum->md);
+  g_free (checksum->digest_str);
+  g_free (checksum);
+}
+
+void
+g_checksum_update_internal (GChecksum    *checksum,
+                            const guchar *data,
+                            size_t        length)
+{
+  const GOpenSSLFuncs *funcs;
+
+  g_return_if_fail (checksum != NULL);
+  g_return_if_fail (length == 0 || data != NULL);
+
+  if (checksum->digest_str)
+    {
+      g_warning ("The checksum '%s' has been closed and cannot be updated "
+                 "any more.",
+                 checksum->digest_str);
+      return;
+    }
+
+  if (length == 0)
+    return;
+
+  funcs = g_openssl_get_funcs ();
+
+  /* g_checksum_update() cannot fail, and carrying on would return a wrong
+   * digest later, so a libcrypto failure here is fatal. */
+  if (!funcs->EVP_DigestUpdate (checksum->ctx, data, length))
+    {
+      gchar *err = g_openssl_take_error (funcs);
+      g_error ("GChecksum: EVP_DigestUpdate failed: %s", err);
+    }
+}
+
+void
+g_checksum_update (GChecksum    *checksum,
+                   const guchar *data,
+                   gssize        length)
+{
+  size_t unsigned_length;
+
+  g_return_if_fail (checksum != NULL);
+  g_return_if_fail (length == 0 || data != NULL);
+
+  if (length < 0)
+    unsigned_length = strlen ((const gchar *) data);
+  else
+    unsigned_length = (size_t) length;
+
+  g_checksum_update_internal (checksum, data, unsigned_length);
+}
+
+static void
+checksum_close (GChecksum *checksum)
+{
+  const GOpenSSLFuncs *funcs;
+  unsigned int len = 0;
+
+  if (checksum->digest_str != NULL)
+    return;
+
+  funcs = g_openssl_get_funcs ();
+
+  if (!funcs->EVP_DigestFinal_ex (checksum->ctx, checksum->digest, &len))
+    {
+      gchar *err = g_openssl_take_error (funcs);
+      g_error ("GChecksum: EVP_DigestFinal_ex failed: %s", err);
+    }
+
+  g_assert ((gssize) len == g_checksum_type_get_length (checksum->type));
+
+  checksum->digest_str = gchecksum_digest_to_string (checksum->digest, len);
+}
+
+const gchar *
+g_checksum_get_string (GChecksum *checksum)
+{
+  g_return_val_if_fail (checksum != NULL, NULL);
+
+  checksum_close (checksum);
+
+  return checksum->digest_str;
+}
+
+void
+g_checksum_get_digest (GChecksum  *checksum,
+                       guint8     *buffer,
+                       gsize      *digest_len)
+{
+  gssize signed_len;
+  gsize len;
+
+  g_return_if_fail (checksum != NULL);
+
+  signed_len = g_checksum_type_get_length (checksum->type);
+  g_assert (signed_len >= 0);  /* @checksum should be internally consistent */
+  len = (size_t) signed_len;
+  g_return_if_fail (*digest_len >= len);
+
+  checksum_close (checksum);
+
+  memcpy (buffer, checksum->digest, len);
+  *digest_len = len;
+}
