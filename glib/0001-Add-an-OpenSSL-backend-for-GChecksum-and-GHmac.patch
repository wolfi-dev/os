+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this library; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef __G_OPENSSL_PRIVATE_H__
+#define __G_OPENSSL_PRIVATE_H__
+
+#include "config.h"
+
+#ifndef USE_OPENSSL
+#error "build configuration error"
+#endif
+
+/* Only the declarations are used; libcrypto is never linked directly. */
+#include <openssl/core.h>
+#include <openssl/core_names.h>
+#include <openssl/evp.h>
+#include <openssl/err.h>
+#include <openssl/params.h>
+
+#include "gchecksum.h"
+
+G_BEGIN_DECLS
+
+#define G_OPENSSL_FUNC(name) __typeof__ (name) *name
+
+/* Function pointers into the dlopen()ed libcrypto. The member names match
+ * the libcrypto symbols, and the types are taken from the OpenSSL headers,
+ * so a prototype change in a new OpenSSL release fails the build rather
+ * than miscalling at runtime. */
+typedef struct
+{
+  G_OPENSSL_FUNC (EVP_MD_fetch);
+  G_OPENSSL_FUNC (EVP_MD_free);
+  G_OPENSSL_FUNC (EVP_MD_up_ref);
+  G_OPENSSL_FUNC (EVP_MD_CTX_new);
+  G_OPENSSL_FUNC (EVP_MD_CTX_free);
+  G_OPENSSL_FUNC (EVP_MD_CTX_dup);
+  G_OPENSSL_FUNC (EVP_DigestInit_ex2);
+  G_OPENSSL_FUNC (EVP_DigestUpdate);
+  G_OPENSSL_FUNC (EVP_DigestFinal_ex);
+  G_OPENSSL_FUNC (EVP_MAC_fetch);
+  G_OPENSSL_FUNC (EVP_MAC_free);
+  G_OPENSSL_FUNC (EVP_MAC_CTX_new);
+  G_OPENSSL_FUNC (EVP_MAC_CTX_free);
+  G_OPENSSL_FUNC (EVP_MAC_CTX_dup);
+  G_OPENSSL_FUNC (EVP_MAC_init);
+  G_OPENSSL_FUNC (EVP_MAC_update);
+  G_OPENSSL_FUNC (EVP_MAC_final);
+  G_OPENSSL_FUNC (OSSL_PARAM_construct_utf8_string);
+  G_OPENSSL_FUNC (OSSL_PARAM_construct_end);
+  G_OPENSSL_FUNC (ERR_get_error);
+  G_OPENSSL_FUNC (ERR_error_string_n);
+  G_OPENSSL_FUNC (ERR_clear_error);
+} GOpenSSLFuncs;
+
+#undef G_OPENSSL_FUNC
+
+/* Loads libcrypto on first use. Aborts the process if it cannot be loaded:
+ * silently falling back to the built-in implementation would defeat the
+ * purpose of this backend. */
+const GOpenSSLFuncs *g_openssl_get_funcs (void);
+
+/* OpenSSL algorithm name for @type, or %NULL if unknown. */
+const char *g_openssl_digest_name (GChecksumType type);
+
+/* Pops the thread's OpenSSL error queue into a newly allocated string and
+ * clears it, so that stale errors are not seen by other OpenSSL users in
+ * the process (e.g. glib-networking checking ERR_get_error()). */
+gchar *g_openssl_take_error (const GOpenSSLFuncs *funcs);
+
+G_END_DECLS
+
+#endif /* __G_OPENSSL_PRIVATE_H__ */
