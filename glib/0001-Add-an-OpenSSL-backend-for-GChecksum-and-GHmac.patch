diff --git a/glib/gopenssl.c b/glib/gopenssl.c
new file mode 100644
index 0000000..87012c9
--- /dev/null
+++ b/glib/gopenssl.c
@@ -0,0 +1,134 @@
+/* gopenssl.c - libcrypto loader for the OpenSSL GChecksum/GHmac backend
+ *
+ * Copyright (C) 2026 Chainguard, Inc.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this library; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <dlfcn.h>
+
+#include "gopensslprivate.h"
+
+#include "gmessages.h"
+#include "gstrfuncs.h"
+#include "gthread.h"
+
+/* libcrypto is dlopen()ed rather than linked so that libglib-2.0.a can
+ * still be linked statically without a static libcrypto, and so that
+ * processes which never compute a checksum do not load it. */
+
+static GOpenSSLFuncs openssl_funcs;
+
+#define LOAD(name) \
+  G_STMT_START { \
+    openssl_funcs.name = dlsym (handle, #name); \
+    if (openssl_funcs.name == NULL) \
+      g_error ("GChecksum: cannot find %s in %s: %s", \
+               #name, OPENSSL_LIBCRYPTO_SONAME, dlerror ()); \
+  } G_STMT_END
+
+static void
+load_libcrypto (void)
+{
+  void *handle;
+
+  handle = dlopen (OPENSSL_LIBCRYPTO_SONAME, RTLD_NOW | RTLD_LOCAL);
+  if (handle == NULL)
+    g_error ("GChecksum: cannot load %s: %s",
+             OPENSSL_LIBCRYPTO_SONAME, dlerror ());
+
+  LOAD (EVP_MD_fetch);
+  LOAD (EVP_MD_free);
+  LOAD (EVP_MD_up_ref);
+  LOAD (EVP_MD_CTX_new);
+  LOAD (EVP_MD_CTX_free);
+  LOAD (EVP_MD_CTX_dup);
+  LOAD (EVP_DigestInit_ex2);
+  LOAD (EVP_DigestUpdate);
+  LOAD (EVP_DigestFinal_ex);
+  LOAD (EVP_MAC_fetch);
+  LOAD (EVP_MAC_free);
+  LOAD (EVP_MAC_CTX_new);
+  LOAD (EVP_MAC_CTX_free);
+  LOAD (EVP_MAC_CTX_dup);
+  LOAD (EVP_MAC_init);
+  LOAD (EVP_MAC_update);
+  LOAD (EVP_MAC_final);
+  LOAD (OSSL_PARAM_construct_utf8_string);
+  LOAD (OSSL_PARAM_construct_end);
+  LOAD (ERR_get_error);
+  LOAD (ERR_error_string_n);
+  LOAD (ERR_clear_error);
+
+  /* The handle is intentionally never closed. */
+}
+
+#undef LOAD
+
+const GOpenSSLFuncs *
+g_openssl_get_funcs (void)
+{
+  static gsize loaded = 0;
+
+  if (g_once_init_enter (&loaded))
+    {
+      load_libcrypto ();
+      g_once_init_leave (&loaded, 1);
+    }
+
+  return &openssl_funcs;
+}
+
+const char *
+g_openssl_digest_name (GChecksumType type)
+{
+  switch (type)
+    {
+    case G_CHECKSUM_MD5:
+      return "MD5";
+    case G_CHECKSUM_SHA1:
+      return "SHA1";
+    case G_CHECKSUM_SHA256:
+      return "SHA256";
+    case G_CHECKSUM_SHA384:
+      return "SHA384";
+    case G_CHECKSUM_SHA512:
+      return "SHA512";
+    default:
+      return NULL;
+    }
+}
+
+gchar *
+g_openssl_take_error (const GOpenSSLFuncs *funcs)
+{
+  char buf[256];
+  unsigned long err;
+
+  err = funcs->ERR_get_error ();
+  if (err == 0)
+    {
+      funcs->ERR_clear_error ();
+      return g_strdup ("unknown error");
+    }
+
+  funcs->ERR_error_string_n (err, buf, sizeof (buf));
+  funcs->ERR_clear_error ();
+
+  return g_strdup (buf);
+}
