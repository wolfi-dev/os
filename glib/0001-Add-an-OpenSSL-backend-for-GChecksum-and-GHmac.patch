@@ -1786,6 +1792,10 @@ g_checksum_get_digest (GChecksum  *checksum,
 
   *digest_len = len;
 }
+#else /* USE_OPENSSL */
+/* Implemented in gchecksum-openssl.c */
+#define checksum_update_internal g_checksum_update_internal
+#endif /* !USE_OPENSSL */
 
 /**
  * g_compute_checksum_for_data:
