#!/usr/bin/env python3
"""Gate the build on an abi-compliance-checker HTML report.

Reads the compatibility percentage for the requested kind (binary or source)
and exits non-zero if it falls below the given threshold.
"""
import argparse
import sys

from bs4 import BeautifulSoup

# abi-compliance-checker renders each kind in its own tab div.
TAB_IDS = {"binary": "BinaryTab", "source": "SourceTab"}


def compatibility(html, kind):
    soup = BeautifulSoup(html, "html.parser")
    # Scope to the requested tab so we never read the other kind's number.
    tab = soup.find(id=TAB_IDS[kind])
    if tab is None:
        raise ValueError(f"no {TAB_IDS[kind]} section in report")
    header = tab.find("th", string="Compatibility")
    if header is None:
        raise ValueError(f"no Compatibility row in {TAB_IDS[kind]}")
    return float(header.find_next("td").get_text(strip=True).rstrip("%"))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("report", help="path to the abi-compliance-checker report")
    parser.add_argument(
        "--kind",
        choices=TAB_IDS,
        default="binary",
        help="which compatibility to gate on (default: binary)",
    )
    parser.add_argument(
        "--threshold",
        type=float,
        required=True,
        help="minimum acceptable compatibility percentage",
    )
    args = parser.parse_args()

    with open(args.report, encoding="utf-8") as f:
        compat = compatibility(f.read(), args.kind)

    print(f"libc {args.kind} ABI compatibility: {compat}% (threshold {args.threshold}%)")
    if compat < args.threshold:
        sys.exit(f"{args.kind} ABI compatibility {compat}% is below {args.threshold}%")


if __name__ == "__main__":
    main()
