From 42c7a33554d037f6b53a02b5669a80325836d7e2 Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Tue, 18 Aug 2026 11:10:09 +0000
Subject: [PATCH 3/4] go: buildcfg: emit chainguard go package name and version

Change-Id: Ic0db244d07a1bb3f6251f7eb948a82a0df4b24a0
---
 src/cmd/dist/buildruntime.go    | 1 +
 src/cmd/go/internal/load/pkg.go | 3 +++
 2 files changed, 4 insertions(+)

diff --git a/src/cmd/dist/buildruntime.go b/src/cmd/dist/buildruntime.go
index 87e8867176..26c0136ca0 100644
--- a/src/cmd/dist/buildruntime.go
+++ b/src/cmd/dist/buildruntime.go
@@ -68,6 +68,7 @@ func mkbuildcfg(file string) {
 	fmt.Fprintf(&buf, "const defaultGOARCH = runtime.GOARCH\n")
 	fmt.Fprintf(&buf, "const DefaultGOFIPS140 = `%s`\n", gofips140)
 	fmt.Fprintf(&buf, "const DefaultCGO_ENABLED = %s\n", quote(os.Getenv("CGO_ENABLED")))
+	fmt.Fprintf(&buf, "const ChainguardGoPackage = %s\n", quote(os.Getenv("CHAINGUARD_GO_PACKAGE")))
 
 	writefile(buf.String(), file, writeSkipSame)
 }
diff --git a/src/cmd/go/internal/load/pkg.go b/src/cmd/go/internal/load/pkg.go
index e949410129..2eab585133 100644
--- a/src/cmd/go/internal/load/pkg.go
+++ b/src/cmd/go/internal/load/pkg.go
@@ -2450,6 +2450,9 @@ func (p *Package) setBuildInfo(ctx context.Context, f *modfetch.Fetcher, autoVCS
 	if BuildAsmflags.present {
 		appendSetting("-asmflags", BuildAsmflags.String())
 	}
+	if buildcfg.ChainguardGoPackage != "" {
+		appendSetting("chainguard_go_package", buildcfg.ChainguardGoPackage)
+	}
 	buildmode := cfg.BuildBuildmode
 	if buildmode == "default" {
 		if p.Name == "main" {
