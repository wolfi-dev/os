Upstream silnrsi/grcompiler commit f49b87f66cd40429a56bbb46e215a6d4e4be33d5
(Tim Eves, 2024-03-13, "Fix change in FetchContent_Decl behaviour in CMake
3.28"), unchanged. Not in any release: v5.2.1 (2021) is the latest tag.

compiler/CMakeLists.txt declared FetchContent for ICU unconditionally with
URL ${ICU_URL}; on Linux ICU_URL is unset (the system ICU is used), and
CMake 3.28 and later reject the empty URL:

  CMake Error at FetchContent.cmake (message):
    URL keyword needs to be followed by at least one URL

Older CMake treated the empty parameter as a no-op.

diff --git a/compiler/CMakeLists.txt b/compiler/CMakeLists.txt
index 2b49253..cefe4bd 100644
--- a/compiler/CMakeLists.txt
+++ b/compiler/CMakeLists.txt
@@ -1,9 +1,9 @@
 project(compiler VERSION 5.2.1)
 cmake_policy(SET CMP0074 NEW)
 
-FetchContent_Declare(icu URL ${ICU_URL})
 
 if (DEFINED ICU_URL OR DEFINED FETCHCONTENT_SOURCE_DIR_ICU)
+    FetchContent_Declare(icu URL ${ICU_URL})
     FetchContent_GetProperties(icu)
     if (NOT icu_POPULATED)
         message(STATUS "Fetching: " ${ICU_URL})
