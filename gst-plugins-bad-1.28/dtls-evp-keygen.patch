Upstream: https://gitlab.freedesktop.org/gstreamer/gstreamer/-/merge_requests/12964

From dea3066e0bbf197118456ba98da4008719f263b8 Mon Sep 17 00:00:00 2001
From: Thomas Bechtold <thomasbechtold@jpberlin.de>
Date: Wed, 4 Nov 2026 13:28:05 +0100
Subject: [PATCH] dtls: generate the default certificate key with EVP_EC_gen()

EC_KEY_generate_key() is deprecated since OpenSSL 3.0 and runs the
built-in libcrypto EC code instead of going through a provider. On
systems that enforce the FIPS provider, the key of the default
certificate was therefore generated outside of the FIPS module, while
the handshake itself already uses it.

Use EVP_EC_gen() with OpenSSL >= 3.0 and keep the EC_KEY code path for
older versions.
---
 .../ext/dtls/gstdtlscertificate.c             | 25 +++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/subprojects/gst-plugins-bad/ext/dtls/gstdtlscertificate.c b/subprojects/gst-plugins-bad/ext/dtls/gstdtlscertificate.c
index 1cba4789b55..7c449ced6e9 100644
--- a/subprojects/gst-plugins-bad/ext/dtls/gstdtlscertificate.c
+++ b/subprojects/gst-plugins-bad/ext/dtls/gstdtlscertificate.c
@@ -192,8 +192,10 @@ static void
 init_generated (GstDtlsCertificate * self)
 {
   GstDtlsCertificatePrivate *priv = self->priv;
+#if OPENSSL_VERSION_NUMBER < 0x30000000L
   EC_KEY *ec;
   int curve;
+#endif
   BIGNUM *serial_number;
   ASN1_INTEGER *asn1_serial_number;
   X509_NAME *name = NULL;
@@ -203,6 +205,26 @@ init_generated (GstDtlsCertificate * self)
   g_return_if_fail (!priv->x509);
   g_return_if_fail (!priv->private_key);
 
+  GST_INFO_OBJECT (self,
+      "Generating a default DTLS certificate with a ECDSA P-256 private key");
+
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+  priv->private_key = EVP_EC_gen ("P-256");
+
+  if (!priv->private_key) {
+    GST_WARNING_OBJECT (self, "failed to generate EC key");
+    return;
+  }
+
+  priv->x509 = X509_new ();
+
+  if (!priv->x509) {
+    GST_WARNING_OBJECT (self, "failed to create certificate");
+    EVP_PKEY_free (priv->private_key);
+    priv->private_key = NULL;
+    return;
+  }
+#else
   priv->private_key = EVP_PKEY_new ();
 
   if (!priv->private_key) {
@@ -219,8 +241,6 @@ init_generated (GstDtlsCertificate * self)
     return;
   }
 
-  GST_INFO_OBJECT (self,
-      "Generating a default DTLS certificate with a ECDSA P-256 private key");
   curve = OBJ_txt2nid ("prime256v1");
   G_GNUC_BEGIN_IGNORE_DEPRECATIONS;
   ec = EC_KEY_new_by_curve_name (curve);
@@ -259,6 +279,7 @@ init_generated (GstDtlsCertificate * self)
     return;
   }
   G_GNUC_END_IGNORE_DEPRECATIONS;
+#endif
 
   X509_set_version (priv->x509, 2);
 
