From 973bba4c9c5e6cd45b673a51607b8ec2a0e63fa2 Mon Sep 17 00:00:00 2001
From: Dustin Kirkland <dustin.kirkland@chainguard.dev>
Date: Mon, 26 Oct 2026 06:39:20 -0500
Subject: [PATCH] cf/resolv.m4: detect the resolver through resolv.h on glibc <
 2.34

Since commit 323d555c82 ("cf: Do not use headers and argument lists in
AC_FIND_FUNC_NO_LIBS2"), AC_FIND_FUNC links a made-up prototype such as
"char res_search (void);" without including any headers.  glibc before
2.34 does not export res_search, res_nsearch or dn_expand under those
names: libresolv exports __res_search, __res_nsearch and __dn_expand, and
<resolv.h> maps the public names onto them with macros.  On those glibc
versions all three checks fail, resolve.c compiles its stub branch (no DNS
SRV/TXT lookups), and lib/roken's parse_reply-test fails to link with
"undefined reference to `parse_reply'".

Probe each function through <resolv.h> first, with and without -lresolv,
and seed AC_FIND_FUNC's cache with the result.  On glibc >= 2.34 the
functions are in libc under their public names, and the result is the
same as before.

Not yet upstream: heimdal master still has the header-less check.
---
 cf/resolv.m4 | 42 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/cf/resolv.m4 b/cf/resolv.m4
index 49c868ab0..1e685f90e 100644
--- a/cf/resolv.m4
+++ b/cf/resolv.m4
@@ -3,6 +3,45 @@ dnl
 dnl $Id$
 dnl
 
+dnl glibc before 2.34 exports the resolver functions only under internal
+dnl names (__res_search, __res_nsearch, __dn_expand) in libresolv, and
+dnl <resolv.h> maps the public names onto them with macros.  AC_FIND_FUNC
+dnl links a made-up prototype without any headers (see
+dnl find-func-no-libs2.m4), so it cannot find them there and roken ends up
+dnl with the stub resolver.  Probe through <resolv.h> first and seed
+dnl AC_FIND_FUNC's cache with the result.
+dnl
+dnl rk_RESOLV_FUNC_HDR(func, call)
+AC_DEFUN([rk_RESOLV_FUNC_HDR],[
+AC_CACHE_CHECK([for $1 via resolv.h], [rk_cv_resolv_hdr_$1], [
+rk_cv_resolv_hdr_$1=no
+rk_save_LIBS="$LIBS"
+for rk_lib in "" -lresolv; do
+	LIBS="$rk_lib $rk_save_LIBS"
+	AC_LINK_IFELSE([AC_LANG_PROGRAM([[
+#include <stdio.h>
+#ifdef HAVE_SYS_TYPES_H
+#include <sys/types.h>
+#endif
+#ifdef HAVE_NETINET_IN_H
+#include <netinet/in.h>
+#endif
+#ifdef HAVE_ARPA_NAMESER_H
+#include <arpa/nameser.h>
+#endif
+#ifdef HAVE_RESOLV_H
+#include <resolv.h>
+#endif
+]],[[return $2;]])],
+	[if test -n "$rk_lib"; then rk_cv_resolv_hdr_$1="$rk_lib"; else rk_cv_resolv_hdr_$1=yes; fi; break])
+done
+LIBS="$rk_save_LIBS"
+])
+if test "$rk_cv_resolv_hdr_$1" != no; then
+	ac_cv_funclib_$1="$rk_cv_resolv_hdr_$1"
+fi
+])
+
 AC_DEFUN([rk_RESOLV],[
 
 AC_CHECK_HEADERS([arpa/nameser.h dns.h])
@@ -19,6 +58,7 @@ AC_CHECK_HEADERS(resolv.h, , , [AC_INCLUDES_DEFAULT
 #endif
 ])
 
+rk_RESOLV_FUNC_HDR([res_search], [res_search("", 0, 0, (unsigned char *)0, 0)])
 AC_FIND_FUNC(res_search, resolv,
 [
 #include <stdio.h>
@@ -37,6 +77,7 @@ AC_FIND_FUNC(res_search, resolv,
 ],
 [0,0,0,0,0])
 
+rk_RESOLV_FUNC_HDR([res_nsearch], [res_nsearch((res_state)0, "", 0, 0, (unsigned char *)0, 0)])
 AC_FIND_FUNC(res_nsearch, resolv,
 [
 #include <stdio.h>
@@ -82,6 +123,7 @@ AC_FIND_FUNC_NO_LIBS(dns_search,,
 [0,0,0,0,0,0,0,0])
 
 
+rk_RESOLV_FUNC_HDR([dn_expand], [dn_expand((const unsigned char *)0, (const unsigned char *)0, (const unsigned char *)0, (char *)0, 0)])
 AC_FIND_FUNC(dn_expand, resolv,
 [
 #include <stdio.h>
