Publish the C# sample framework-dependent instead of self-contained.

A self-contained single-file publish embeds Microsoft's singlefilehost
from the linux-<arch> NuGet host pack, which compiles in a Brotli
decoder affected by CVE-2026-111497. A framework-dependent publish
embeds only apphost, and the app runs on the system .NET runtime.
RollForward=Major lets the net8.0 sample run on a newer major release
when .NET 8 is not installed.

--- a/Makefile
+++ b/Makefile
@@ -430,7 +430,8 @@
 	$(eval CSHARP_TMP := $(shell mktemp -d))
 	HOME=/tmp DOTNET_CLI_HOME=/tmp dotnet publish csharp/howdy.csproj \
 		-c Release \
-		--self-contained \
+		--no-self-contained \
+		-p:RollForward=Major \
 		-r linux-$(shell uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/') \
 		-p:PublishSingleFile=true \
 		-o $(CSHARP_TMP)
