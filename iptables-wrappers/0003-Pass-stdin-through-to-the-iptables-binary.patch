From 42b3cf0ecce1bb86c26f382e7718772a7426ac64 Mon Sep 17 00:00:00 2001
From: Thomas Bechtold <thomas.bechtold@chainguard.dev>
Date: Mon, 28 Sep 2026 21:12:21 +0000
Subject: [PATCH] Pass stdin through to the iptables binary

iptables-restore reads its ruleset from stdin. The wrapper only wired up
stdout and stderr, so the re-executed binary read /dev/null: a restore
through the wrapper exited 0 and applied nothing. Every call goes through
the wrapper when the root filesystem is read-only and the symlinks cannot
be redirected.
---
 main.go | 1 +
 1 file changed, 1 insertion(+)

diff --git a/main.go b/main.go
index 459337d..666abbc 100644
--- a/main.go
+++ b/main.go
@@ -93,6 +93,7 @@ func main() {
 	}
 
 	cmdIPTables := exec.CommandContext(ctx, binaryPath, args...)
+	cmdIPTables.Stdin = os.Stdin
 	cmdIPTables.Stdout = os.Stdout
 	cmdIPTables.Stderr = os.Stderr
 
