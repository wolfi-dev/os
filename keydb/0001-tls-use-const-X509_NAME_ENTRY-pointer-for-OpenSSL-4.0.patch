From 7e6862e83df73fed3f3aa89f0c17346303d5d696 Mon Sep 17 00:00:00 2001
From: Mritunjay Sharma <mritunjay.sharma@chainguard.dev>
Date: Fri, 9 Oct 2026 17:55:20 +0530
Subject: [PATCH] tls: use const X509_NAME_ENTRY pointer for OpenSSL 4.0

OpenSSL 4.0 made X509_get_subject_name() return a const X509_NAME *,
so X509_NAME_get_entry() now yields a const X509_NAME_ENTRY *. Assigning
that to a non-const pointer is an error in C++:

  tls.cpp:581:47: error: invalid conversion from 'const X509_NAME_ENTRY*'
  to 'X509_NAME_ENTRY*' [-fpermissive]

The entry is only passed to X509_NAME_ENTRY_get_data(), which takes a
const pointer in every supported OpenSSL release, so declaring it const
is a type-only change that keeps building against OpenSSL 1.1.x/3.x.

Upstream: not submitted (no upstream OpenSSL 4 fix; KeyDB tls.cpp is
unchanged on main since 2023). Chainguard-authored.
---
 src/tls.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/tls.cpp b/src/tls.cpp
index 8a8a97a..fefc84d 100644
--- a/src/tls.cpp
+++ b/src/tls.cpp
@@ -578,7 +578,7 @@ bool tlsCheckCertificateAgainstAllowlist(tls_connection* conn, std::set<sdsstrin
     TCleanup certClen([cert]{X509_free(cert);});
 
     /* Check the common name (CN) of the certificate first */
-    X509_NAME_ENTRY * ne = X509_NAME_get_entry(X509_get_subject_name(cert), X509_NAME_get_index_by_NID(X509_get_subject_name(cert), NID_commonName, -1));
+    const X509_NAME_ENTRY * ne = X509_NAME_get_entry(X509_get_subject_name(cert), X509_NAME_get_index_by_NID(X509_get_subject_name(cert), NID_commonName, -1));
     *commonName = reinterpret_cast<const char*>(ASN1_STRING_get0_data(X509_NAME_ENTRY_get_data(ne)));
 
     tlsSetCertificateFingerprint(conn, cert);
