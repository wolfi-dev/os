 {
-    SSL_library_init();
-    SSL_load_error_strings();
-    OpenSSL_add_all_algorithms();
     ex_context_id = SSL_get_ex_new_index(0, NULL, NULL, NULL, NULL);
     ex_handle_id = SSL_get_ex_new_index(0, NULL, NULL, NULL, NULL);
     return 0;
@@ -141,16 +138,7 @@ domain_match(const char *presented, size_t plen, const char *expected)
 static GENERAL_NAMES *
 get_cert_sans(X509 *x)
 {
-    int ext;
-    X509_EXTENSION *san_ext;
-
-    ext = X509_get_ext_by_NID(x, NID_subject_alt_name, -1);
-    if (ext < 0)
-        return NULL;
-    san_ext = X509_get_ext(x, ext);
-    if (san_ext == NULL)
-        return NULL;
-    return X509V3_EXT_d2i(san_ext);
+    return X509_get_ext_d2i(x, NID_subject_alt_name, NULL, NULL);
 }
 
 /* Fetch a CN value from the subjct name field, returning its length, or -1 if
@@ -158,12 +146,29 @@ get_cert_sans(X509 *x)
 static int
 get_cert_cn(X509 *x, char *buf, size_t bufsize)
 {
-    X509_NAME *name;
+    const X509_NAME *name;
+    const X509_NAME_ENTRY *entry;
+    const ASN1_STRING *data;
+    int loc, len;
 
     name = X509_get_subject_name(x);
     if (name == NULL)
         return -1;
-    return X509_NAME_get_text_by_NID(name, NID_commonName, buf, bufsize);
+    loc = X509_NAME_get_index_by_NID(name, NID_commonName, -1);
+    if (loc < 0)
+        return -1;
+    entry = X509_NAME_get_entry(name, loc);
+    data = (entry != NULL) ? X509_NAME_ENTRY_get_data(entry) : NULL;
+    if (data == NULL)
+        return -1;
+    len = ASN1_STRING_length(data);
+    if (len < 0 || bufsize == 0)
+        return -1;
+    if ((size_t)len >= bufsize)
+        len = bufsize - 1;
+    memcpy(buf, ASN1_STRING_get0_data(data), len);
+    buf[len] = '\0';
+    return len;
 }
 
