From: James Page <james.page@chainguard.dev>
Subject: [PATCH] cdk: build with OpenSSL 4 const X.509 accessors

OpenSSL 4 returns const-qualified pointers from X509_get_subject_name(),
X509_NAME_get_entry() and X509_NAME_ENTRY_get_data(), which breaks the
C++ build of matches_common_name(). Hold them as const, casting only
for the older OpenSSL APIs that still take mutable arguments.

Upstream-Status: Pending
---
diff --git a/cdk/foundation/connection_openssl.cc b/cdk/foundation/connection_openssl.cc
index bd525af..282cc41 100644
--- a/cdk/foundation/connection_openssl.cc
+++ b/cdk/foundation/connection_openssl.cc
@@ -721,13 +721,13 @@ public:
   }
 };
 
-const unsigned char * get_cn(ASN1_STRING *cn_asn1)
+const unsigned char * get_cn(const ASN1_STRING *cn_asn1)
 {
   const unsigned char *cn = NULL;
 #if OPENSSL_VERSION_NUMBER > 0x10100000L
   cn = ASN1_STRING_get0_data(cn_asn1);
 #else
-  cn = (const unsigned char*)(ASN1_STRING_data(cn_asn1));
+  cn = (const unsigned char*)(ASN1_STRING_data(const_cast<ASN1_STRING*>(cn_asn1)));
 #endif
 
   // There should not be any NULL embedded in the CN
@@ -741,13 +741,18 @@ bool matches_common_name(const std::string &host_name, const X509 *server_cert)
 {
   const unsigned char *cn = NULL;
   int cn_loc = -1;
-  ASN1_STRING *cn_asn1 = NULL;
-  X509_NAME_ENTRY *cn_entry = NULL;
-  X509_NAME *subject = NULL;
+  const ASN1_STRING *cn_asn1 = NULL;
+  const X509_NAME_ENTRY *cn_entry = NULL;
+  const X509_NAME *subject = NULL;
 
   subject = X509_get_subject_name((X509 *)server_cert);
   // Find the CN location in the subject
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
   cn_loc = X509_NAME_get_index_by_NID(subject, NID_commonName, -1);
+#else
+  cn_loc = X509_NAME_get_index_by_NID(const_cast<X509_NAME*>(subject),
+                                      NID_commonName, -1);
+#endif
 
   if (cn_loc < 0)
   {
