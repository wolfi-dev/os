 // 8. If users have reset the root cert store by calling
 //    tls.setDefaultCACertificates(), the store will be populated with
 //    the certificates provided by users.
+// 9. With --openssl-use-def-ca-store builds, --openssl-ca-bundled-fallback
+//    (on by default, cleared by an explicit --use-openssl-ca) adds the
+//    bundled CA certificates when OpenSSL has no CA location configured:
+//    neither SSL_CERT_FILE nor SSL_CERT_DIR is set and nothing exists at
+//    OpenSSL's default certificate file or directory. A configured, present
+//    or unreadable location is used as is.
 // TODO(joyeecheung): maybe these rules need a bit of consolidation?
+
+// Whether OpenSSL has a CA location configured. Structural on purpose: it
+// looks at the environment and at the existence of the default paths, not at
+// what X509_STORE_set_default_paths() loaded, because the hash directory
+// lookup loads certificates lazily and an explicitly configured but empty or
+// broken location must not be replaced. Only a definite absence (ENOENT,
+// ENOTDIR) counts as missing; a dangling symlink, a permission error or any
+// other failure counts as present, so an existing store that cannot be read
+// is never replaced by the bundled roots.
+static bool HasOpenSSLCALocation() {
+  std::string value;
+  if (credentials::SafeGetenv(X509_get_default_cert_file_env(), &value) ||
+      credentials::SafeGetenv(X509_get_default_cert_dir_env(), &value)) {
+    return true;
+  }
+  for (const char* path :
+       {X509_get_default_cert_file(), X509_get_default_cert_dir()}) {
+    if (path == nullptr || *path == '\0') continue;
+    uv_fs_t req;
+    int r = uv_fs_lstat(nullptr, &req, path, nullptr);
+    uv_fs_req_cleanup(&req);
+    if (r != UV_ENOENT && r != UV_ENOTDIR) return true;
+  }
+  return false;
+}
