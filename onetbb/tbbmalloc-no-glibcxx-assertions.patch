From: Dustin Kirkland <dustin.kirkland@chainguard.dev>
Subject: [PATCH] Keep libstdc++ assertions out of tbbmalloc in all configurations

tbbmalloc is linked as C, without libstdc++, and already defines
_GLIBCXX_NO_ASSERTIONS to avoid a dependency on libstdc++, but only for
Debug builds. Toolchains that enable libstdc++ assertions in release
builds (-D_GLIBCXX_ASSERTIONS or -Wp,-D_GLIBCXX_ASSERTIONS in CXXFLAGS,
or GCC's -fhardened) leave libtbbmalloc with an undefined reference to
std::__glibcxx_assert_fail, and pure C consumers fail to link.

Define _GLIBCXX_NO_ASSERTIONS for every configuration, and for GCC and
Clang also undefine _GLIBCXX_ASSERTIONS, which _GLIBCXX_NO_ASSERTIONS
does not override, and silence -Whardened about it.

Upstream: https://github.com/uxlfoundation/oneTBB/pull/2239 (approved;
this is its final diff, a2d04fa). Fixes oneTBB#1735.
---
diff --git a/src/tbbmalloc/CMakeLists.txt b/src/tbbmalloc/CMakeLists.txt
index b3fdf34..3cd5b13 100644
--- a/src/tbbmalloc/CMakeLists.txt
+++ b/src/tbbmalloc/CMakeLists.txt
@@ -32,7 +32,7 @@ target_compile_definitions(tbbmalloc
     $<$<CONFIG:DEBUG>:TBB_USE_DEBUG>
     PRIVATE
     # Disable implicit assertions in C++ headers to avoid dependency on libstdc++
-    $<$<CONFIG:DEBUG>:_GLIBCXX_NO_ASSERTIONS>
+    _GLIBCXX_NO_ASSERTIONS
     __TBBMALLOC_BUILD
     $<$<NOT:$<BOOL:${BUILD_SHARED_LIBS}>>:__TBB_DYNAMIC_LOAD_ENABLED=0>
     $<$<NOT:$<BOOL:${BUILD_SHARED_LIBS}>>:__TBB_SOURCE_DIRECTLY_INCLUDED=1>)
@@ -68,6 +68,23 @@ target_compile_options(tbbmalloc
     ${TBB_COMMON_COMPILE_FLAGS}
 )
 
+if (NOT MSVC AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|IntelLLVM")
+    # _GLIBCXX_NO_ASSERTIONS does not override an explicit _GLIBCXX_ASSERTIONS
+    # (e.g. from -D_GLIBCXX_ASSERTIONS or -Wp,-D_GLIBCXX_ASSERTIONS in CXXFLAGS,
+    # or from GCC's -fhardened), so undefine it as well. -Wp is used so that it
+    # also comes after a -Wp,-D passed in CXXFLAGS. Not covered: libstdc++
+    # re-enables _GLIBCXX_ASSERTIONS when _GLIBCXX_DEBUG is defined.
+    target_compile_options(tbbmalloc PRIVATE -Wp,-U_GLIBCXX_ASSERTIONS)
+
+    # Dropping the assertions is intentional, so silence GCC's -Whardened
+    # warning about it, which -Werror (TBB_STRICT) would turn into an error.
+    include(CheckCXXCompilerFlag)
+    check_cxx_compiler_flag(-Wno-hardened TBB_HAS_WNO_HARDENED)
+    if (TBB_HAS_WNO_HARDENED)
+        target_compile_options(tbbmalloc PRIVATE -Wno-hardened)
+    endif()
+endif()
+
 enable_language(C)
 
 # Avoid use of target_link_libraries here as it changes /DEF option to \DEF on Windows.
