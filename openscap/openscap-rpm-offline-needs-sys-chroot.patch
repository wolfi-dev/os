+/*
+ * In offline mode the RPM probes enter the scanned root with chroot(), which
+ * needs CAP_SYS_CHROOT. Without it the probe fails and the whole scan aborts.
+ * Treat the object as not supported instead, as if the probe was not built in.
+ */
+static bool _rpm_probe_unusable_offline(oval_subtype_t type)
+{
+#if defined(__linux__)
+	const char *rootdir;
+	struct __user_cap_header_struct hdr = { .version = _LINUX_CAPABILITY_VERSION_3, .pid = 0 };
+	struct __user_cap_data_struct data[2];
+
+	switch (type) {
+	case OVAL_LINUX_RPM_INFO:
+	case OVAL_LINUX_RPMVERIFY:
+	case OVAL_LINUX_RPMVERIFYFILE:
+	case OVAL_LINUX_RPMVERIFYPACKAGE:
+		break;
+	default:
+		return false;
+	}
+
+	rootdir = getenv("OSCAP_PROBE_ROOT");
+	if (rootdir == NULL || rootdir[0] == '\0')
+		return false;
+
+	if (syscall(SYS_capget, &hdr, data) != 0)
+		return true;
+	return (data[CAP_SYS_CHROOT / 32].effective & (1U << (CAP_SYS_CHROOT % 32))) == 0;
+#else
+	(void)type;
+	return false;
+#endif
+}
