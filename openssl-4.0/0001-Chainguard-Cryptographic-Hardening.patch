 providers/common/capabilities.c |  19 ----
 providers/defltprov.c           | 157 ----------------------------
 ssl/ssl_ciph.c                  |  18 ++++
 ssl/t1_lib.c                    | 104 +++++++++++++++----
 5 files changed, 101 insertions(+), 376 deletions(-)

