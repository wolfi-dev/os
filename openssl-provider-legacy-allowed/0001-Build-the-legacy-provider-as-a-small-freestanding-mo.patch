+
+int ossl_cipher_generic_rand_bytes(PROV_CIPHER_CTX *ctx, unsigned char *out,
+    size_t len)
+{
+#ifdef LEGACY_MODULE
+    /*
+     * The freestanding legacy module has no DRBG and does not link libcrypto,
+     * so RAND_priv_bytes_ex() is unavailable.  Ask the core for entropy from
+     * the parent libcrypto's seed source instead, the same upcall the FIPS
+     * module uses to seed its DRBGs.  Asking for 8 bits per byte with
+     * min_len == max_len == len yields exactly |len| bytes.
+     */
+    unsigned char *buf = NULL;
+    size_t n;
+
+    if (len == 0 || len > INT_MAX / 8 || ctx->provctx == NULL)
+        return 0;
+    n = ossl_prov_get_entropy(ctx->provctx, &buf, (int)(len * 8), len, len);
+    if (n < len) {
+        if (buf != NULL)
+            ossl_prov_cleanup_entropy(ctx->provctx, buf, n);
+        return 0;
+    }
+    memcpy(out, buf, len);
+    ossl_prov_cleanup_entropy(ctx->provctx, buf, n);
+    return 1;
+#else
+    return len != 0 && RAND_priv_bytes_ex(ctx->libctx, out, len, 0) > 0;
+#endif
+}
