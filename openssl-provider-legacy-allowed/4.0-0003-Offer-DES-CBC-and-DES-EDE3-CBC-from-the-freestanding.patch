diff --git a/providers/legacyprov.c b/providers/legacyprov.c
index 3294a412dd..7219789ee3 100644
--- a/providers/legacyprov.c
+++ b/providers/legacyprov.c
@@ -111,11 +111,24 @@ static const OSSL_ALGORITHM legacy_digests[] = {
 };
 
 /*
- * The DES ciphers are only registered when the provider is configured with
- * "enable-des = 1" (in its config section, or via
- * OSSL_PROVIDER_add_conf_parameter()).  They are placed first so that the
- * disabled view is simply the same array starting after them.
+ * Nothing at all is registered unless the provider is configured with
+ * "enable-legacy-allowed = 1" (in its config section, or via
+ * OSSL_PROVIDER_add_conf_parameter()).  Without it the provider still
+ * loads and activates, and stays registered with the core, but every
+ * operation query answers with an empty algorithm list -- the same
+ * outcome for fetches as "activate = 0", except that the provider is
+ * present and OSSL_PROVIDER_available() reports it.
+ *
+ * On top of that, the DES ciphers are only registered when the provider
+ * is also configured with "enable-des = 1".  They are placed first so that
+ * the disabled view is simply the same array starting after them.
+ *
+ * Both values are read through the core's get_params each time an
+ * operation is queried, but the core remembers which operations a
+ * provider has already been asked about, so they must be set before the
+ * first fetch to take effect.
  */
+#define LEGACY_ENABLE_ALLOWED_PARAM "enable-legacy-allowed"
 #ifndef OPENSSL_NO_DES
 #define LEGACY_DES_CIPHERS 2
 #else
@@ -141,6 +154,8 @@ static const OSSL_ALGORITHM *legacy_query(void *provctx, int operation_id,
     int *no_cache)
 {
     *no_cache = 0;
+    if (!ossl_prov_ctx_get_bool_param(provctx, LEGACY_ENABLE_ALLOWED_PARAM, 0))
+        return NULL;
     switch (operation_id) {
     case OSSL_OP_DIGEST:
         return legacy_digests;
@@ -174,7 +189,10 @@ int OSSL_provider_init(const OSSL_CORE_HANDLE *handle,
     const OSSL_DISPATCH *tmp;
     OSSL_FUNC_core_get_params_fn *c_get_params = NULL;
 
-    /* Needed in every build to read "enable-des" from the configuration */
+    /*
+     * Needed in every build to read "enable-legacy-allowed" and "enable-des"
+     * from the configuration
+     */
     for (tmp = in; tmp->function_id != 0; tmp++)
         if (tmp->function_id == OSSL_FUNC_CORE_GET_PARAMS)
             c_get_params = OSSL_FUNC_core_get_params(tmp);
@@ -228,7 +246,8 @@ int OSSL_provider_init(const OSSL_CORE_HANDLE *handle,
      * The things that do need the core are random DES key generation
      * (OSSL_CIPHER_PARAM_RANDOM_KEY): there is no DRBG in this module, so
      * the entropy upcalls are recorded here and used in its place; and the
-     * "enable-des" configuration parameter, read through core_get_params.
+     * "enable-legacy-allowed" and "enable-des" configuration parameters,
+     * read through core_get_params.
      */
     if (!ossl_prov_seeding_from_dispatch(in))
         return 0;
