     export LD_LIBRARY_PATH=$PWD OPENSSL_CONF=/dev/null
     ./apps/openssl list -digest-algorithms -cipher-algorithms \
         -provider-path $PWD/providers -provider legacy | grep '@ legacy'
     ./apps/openssl list -digest-algorithms -cipher-algorithms \
         -provider-path $PWD/providers -provider legacy \
