From eb92442e9cacc3ecd20b481cb256471f03b70cf6 Mon Sep 17 00:00:00 2001
From: Package Updater <package-updater@chainguard.dev>
Date: 2026-09-13 00:00:00 +0000
Subject: [PATCH] Fix GCC 16 compilation: add missing <cstdint> include

GCC 16 no longer implicitly provides uint8_t without an explicit
include of <cstdint>. Without this include, the compiler fails to
parse 'enum class PredicateType : uint8_t' because it cannot resolve
uint8_t as a type, treating the ':' as a nested-name-specifier
separator instead of an underlying type specifier.

diff --git a/sdk/include/opentelemetry/sdk/metrics/view/predicate_factory.h b/sdk/include/opentelemetry/sdk/metrics/view/predicate_factory.h
index ca7dd4b..501b69b 100644
--- a/sdk/include/opentelemetry/sdk/metrics/view/predicate_factory.h
+++ b/sdk/include/opentelemetry/sdk/metrics/view/predicate_factory.h
@@ -3,6 +3,7 @@
 
 #pragma once
 
+#include <cstdint>
 #include <memory>
 
 #include "opentelemetry/nostd/string_view.h"
