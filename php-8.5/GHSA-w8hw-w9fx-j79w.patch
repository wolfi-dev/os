diff --git a/ext/standard/tests/image/oom_getimagesize_cws.inc b/ext/standard/tests/image/oom_getimagesize_cws.inc
new file mode 100644
index 0000000000..157b9f8fe5
--- /dev/null
+++ b/ext/standard/tests/image/oom_getimagesize_cws.inc
@@ -0,0 +1,17 @@
+<?php
+
+function generate_file(string $path) {
+    $file = fopen($path, 'wb');
+    $uncompressedSize = 320 * 1024 * 1024;
+    fwrite($file, "CWS\x06" . pack('V', $uncompressedSize + 8));
+    $deflate = deflate_init(ZLIB_ENCODING_DEFLATE, ['level' => 9]);
+    $chunk = str_repeat('A', 1024 * 1024);
+    for ($i = 0; $i < 320; $i++) {
+        fwrite($file, deflate_add(
+            $deflate,
+            $chunk,
+            $i === 319 ? ZLIB_FINISH : ZLIB_NO_FLUSH,
+        ));
+    }
+    fclose($file);
+}
