+--EXTENSIONS--
+zend_test
+--INI--
+post_max_size=100K
+--FILE--
+<?php
+
+function make_post_data($value) {
+    $data = ""
+        . "--b\r\n"
+        . "Content-Disposition: form-data; name=\"a\"\r\n"
+        . "Content-Type: application/octet-stream\r\n"
+        . "\r\n"
+        . "$value\r\n"
+        . "\r\n"
+        . "--b--\r\n"
+        ;
