+	if (percent == -1) {
+		/* For memory limit >= 1G, use a fixed 1G buffer */
+		if (heap->limit > 1*1024*1024*1024) {
+			size_t offset = 1*1024*1024*1024;
+			if (ZEND_MM_LIMIT_MAX - heap->limit < offset) {
+				heap->hard_limit = ZEND_MM_LIMIT_MAX;
