diff --git a/ext/zend_test/tests/zend_test_handle_post_data.phpt b/ext/zend_test/tests/zend_test_handle_post_data.phpt
new file mode 100644
index 0000000000..a0c8cbc9ac
--- /dev/null
+++ b/ext/zend_test/tests/zend_test_handle_post_data.phpt
@@ -0,0 +1,85 @@
+--TEST--
+zend_test_handle_post_data() parses POST data from a stream
+--EXTENSIONS--
+zend_test
+--FILE--
+<?php
+
+function stream(string $body) {
+    $stream = fopen('php://memory', 'r+');
+    fwrite($stream, $body);
+    rewind($stream);
+    return $stream;
+}
+
+$body = "--b\r\n"
+    . "Content-Disposition: form-data; name=\"foo\"\r\n"
+    . "\r\n"
+    . "bar\r\n"
+    . "--b\r\n"
+    . "Content-Disposition: form-data; name=\"file\"; filename=\"f.txt\"\r\n"
+    . "Content-Type: text/plain\r\n"
+    . "\r\n"
+    . "file contents\r\n"
+    . "--b--\r\n";
+
+zend_test_handle_post_data(stream($body), 'multipart/form-data; boundary=b', strlen($body));
+
+var_dump($_POST);
+var_dump($_FILES);
+var_dump(is_uploaded_file($_FILES['file']['tmp_name']));
+var_dump(file_get_contents($_FILES['file']['tmp_name']));
+
+// Each call starts over with a fresh $_POST and $_FILES.
+$body = "a=1&b[]=2&b[]=3";
+zend_test_handle_post_data(stream($body), 'application/x-www-form-urlencoded', strlen($body));
+
+var_dump($_POST);
+var_dump($_FILES);
+
+// No handler for this content type, the body is swallowed.
+$body = '{"a":1}';
+zend_test_handle_post_data(stream($body), 'application/json', strlen($body));
+
+var_dump($_POST);
+
+?>
+--EXPECTF--
+array(1) {
+  ["foo"]=>
+  string(3) "bar"
+}
+array(1) {
+  ["file"]=>
+  array(6) {
+    ["name"]=>
+    string(5) "f.txt"
+    ["full_path"]=>
+    string(5) "f.txt"
+    ["type"]=>
+    string(10) "text/plain"
+    ["tmp_name"]=>
+    string(%d) "%s"
+    ["error"]=>
+    int(0)
+    ["size"]=>
+    int(13)
+  }
+}
+bool(true)
+string(13) "file contents"
+array(2) {
+  ["a"]=>
+  string(1) "1"
+  ["b"]=>
+  array(2) {
+    [0]=>
+    string(1) "2"
+    [1]=>
+    string(1) "3"
+  }
+}
+array(0) {
+}
+array(0) {
+}
diff --git a/ext/zlib/tests/oom_deflate_add.phpt b/ext/zlib/tests/oom_deflate_add.phpt
new file mode 100644
index 0000000000..608762109c
--- /dev/null
+++ b/ext/zlib/tests/oom_deflate_add.phpt
@@ -0,0 +1,34 @@
+--TEST--
+deflate_add() output buffer pre-allocation doesn't reach hard limit
+--EXTENSIONS--
+zlib
+--INI--
+memory_limit=512M
+--SKIPIF--
+<?php
+if (getenv("USE_ZEND_ALLOC") === "0") die("skip Zend MM disabled");
+?>
+--FILE--
+<?php
+$limit = 512 * 1024 * 1024;
+$hard = 2 * $limit;
+
+// Allocate the deflate state first so that it counts towards the baseline.
+$ctx = deflate_init(ZLIB_ENCODING_RAW);
+
+// Fill the heap to just under the memory limit.
+$subject = str_repeat("a", $limit - memory_get_usage(true) - 64 * 1024);
+
+// deflate_add() pre-allocates PHP_ZLIB_BUFFER_SIZE_GUESS() bytes for its
+// output, 1.5% more than the chunk, which leaves it too big for the gap that is
+// left before the hard limit.
+$out_size = (int) (strlen($subject) * 1.015) + 23;
+var_dump($out_size > $hard - memory_get_usage(true));
+
+deflate_add($ctx, $subject, ZLIB_FINISH);
+echo "not reached\n";
+?>
+--EXPECTF--
+bool(true)
+
+Fatal error: Allowed memory size of 536870912 bytes exhausted %S(tried to allocate %d bytes) in %s on line %d
