+/* 40000 one-element arrays: ~760 KB serialized, ~10 MB unserialized. */
+$n = 40000;
+$ser = 'a:' . $n . ':{';
+for ($i = 0; $i < $n; $i++) {
+    $ser .= 'i:' . $i . ';a:1:{i:0;i:0;}';
