+static size_t scale_by_percent(size_t value, zend_long percent)
+{
+	if (percent <= 0) {
+		return 0;
+	}
+
+	size_t p = (size_t)percent;
+	size_t q = value / 100;
+	size_t r = value % 100;
+
+	if (q > SIZE_MAX / p) {
+		return SIZE_MAX;
+	}
+
+	size_t hi = q * p;
+	size_t lo = r * (p / 100) + r * (p % 100) / 100;
+
+	if (hi > SIZE_MAX - lo) {
+		return SIZE_MAX;
+	}
+	return hi + lo;
+}
