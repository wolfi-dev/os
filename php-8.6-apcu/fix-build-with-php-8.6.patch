PHP 8.6 removed the EMPTY_SWITCH_DEFAULT_CASE() macro (UPGRADING.INTERNALS: use
default: ZEND_UNREACHABLE(); instead). These are the apc_persist.c hunks of
upstream commit d29e907791502af89a7996930f8dce5fd8efe4a1 "Fix build against PHP
8.6 (EMPTY_SWITCH_DEFAULT_CASE removed)" (krakjoe/apcu master, 2026-04-10). The
rest of that commit adds a ZEND_UNREACHABLE() fallback for PHP < 8.0 and
reworks the CI workflow, neither of which applies here; the two other 8.6
fixes (XtOffsetOf, php_verror) are cherry-picked in the recipe. Drop with the
first release after 5.1.28.

diff --git a/apc_persist.c b/apc_persist.c
index e322b8d..531695f 100644
--- a/apc_persist.c
+++ b/apc_persist.c
@@ -244,7 +244,8 @@ static zend_bool apc_persist_calc_zval(apc_persist_context_t *ctxt, const zval *
 		case IS_RESOURCE:
 			apc_warning("Cannot store resources in apcu cache");
 			return 0;
-		EMPTY_SWITCH_DEFAULT_CASE()
+		default:
+			ZEND_UNREACHABLE();
 	}
 }
 
@@ -450,7 +451,8 @@ static void apc_persist_copy_zval_impl(apc_persist_context_t *ctxt, zval *zv) {
 			if (!ptr) ptr = apc_persist_copy_ref(ctxt, Z_REF_P(zv));
 			ZVAL_REF(zv, ptr);
 			return;
-		EMPTY_SWITCH_DEFAULT_CASE()
+		default:
+			ZEND_UNREACHABLE();
 	}
 }
 
