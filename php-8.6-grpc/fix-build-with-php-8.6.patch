PHP 8.6 removed the XtOffsetOf() alias of C's offsetof() (UPGRADING.INTERNALS:
"Use offsetof() directly"). Mechanical replacement in the PHP extension
sources; no upstream fix exists as of 2026-11-19 (grpc/grpc master still uses
XtOffsetOf). Drop once upstream ships the equivalent.

diff --git a/src/php/ext/grpc/call.h b/src/php/ext/grpc/call.h
index 7abc8fa0e8..90dd5b0fd5 100644
--- a/src/php/ext/grpc/call.h
+++ b/src/php/ext/grpc/call.h
@@ -36,7 +36,7 @@ PHP_GRPC_WRAP_OBJECT_END(wrapped_grpc_call)
 static inline wrapped_grpc_call
 *wrapped_grpc_call_from_obj(zend_object *obj) {
   return (wrapped_grpc_call*)((char*)(obj) -
-                              XtOffsetOf(wrapped_grpc_call, std));
+                              offsetof(wrapped_grpc_call, std));
 }
 
