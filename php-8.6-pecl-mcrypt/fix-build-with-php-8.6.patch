PHP 8.6 changed the stream filter API (php_stream_filter_ops gained seek
callbacks and php_stream_filter_alloc() takes the read/write seek modes) and
removed the INI_STR() macro (UPGRADING.INTERNALS). This is the mcrypt_filter.c
part of upstream pull request
https://github.com/php/pecl-encryption-mcrypt/pull/27 "Fix for PHP 8.6.0beta2"
by Remi Collet (open as of 2026-11-19); its CI-workflow hunk is left out. Drop
once it is merged and released.

diff --git a/mcrypt_filter.c b/mcrypt_filter.c
index 2bdb716..2c3338e 100644
--- a/mcrypt_filter.c
+++ b/mcrypt_filter.c
@@ -140,6 +140,9 @@ static void php_mcrypt_filter_dtor(php_stream_filter *thisfilter)
 
 static php_stream_filter_ops php_mcrypt_filter_ops = {
     php_mcrypt_filter,
+#if PHP_VERSION_ID >= 80600
+    NULL, /* seek */
+#endif
     php_mcrypt_filter_dtor,
     "mcrypt.*"
 };
@@ -147,15 +150,24 @@ static php_stream_filter_ops php_mcrypt_filter_ops = {
 /* {{{ php_mcrypt_filter_create
  * Instantiate mcrypt filter
  */
+#if PHP_VERSION_ID >= 80600
+static php_stream_filter *php_mcrypt_filter_create(const char *filtername, zval *filterparams, bool persistent)
+#else
 static php_stream_filter *php_mcrypt_filter_create(const char *filtername, zval *filterparams, uint8_t persistent)
+#endif
 {
 	int encrypt = 1, iv_len, key_len, keyl, result;
 	const char *cipher = filtername + sizeof("mcrypt.") - 1;
 	zval *tmpzval;
 	MCRYPT mcrypt_module;
 	char *iv = NULL, *key = NULL;
+#if PHP_VERSION_ID >= 80600
+	const char *algo_dir = zend_ini_string_literal("mcrypt.algorithms_dir");
+	const char *mode_dir = zend_ini_string_literal("mcrypt.modes_dir");
+#else
 	char *algo_dir = INI_STR("mcrypt.algorithms_dir");
 	char *mode_dir = INI_STR("mcrypt.modes_dir");
+#endif
 	char *mode = "cbc";
 	php_mcrypt_filter_data *data;
 
@@ -207,7 +219,7 @@ static php_stream_filter *php_mcrypt_filter_create(const char *filtername, zval
 		return NULL;
 	}
 
-	mcrypt_module = mcrypt_module_open((char *)cipher, algo_dir, mode, mode_dir);
+	mcrypt_module = mcrypt_module_open((char *)cipher, (char *)algo_dir, mode, (char *)mode_dir);
 	if (mcrypt_module == MCRYPT_FAILED) {
 		php_error_docref(NULL, E_WARNING, "Could not open encryption module");
 		return NULL;
@@ -265,7 +277,11 @@ static php_stream_filter *php_mcrypt_filter_create(const char *filtername, zval
 	data->block_used = 0;
 	data->persistent = persistent;
 
+#if PHP_VERSION_ID >= 80600
+	return php_stream_filter_alloc(&php_mcrypt_filter_ops, data, persistent, PSFS_SEEKABLE_NEVER, PSFS_SEEKABLE_NEVER);
+#else
 	return php_stream_filter_alloc(&php_mcrypt_filter_ops, data, persistent);
+#endif
 }
 /* }}} */
 
