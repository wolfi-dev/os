PHP 8.6 removed the ZEND_RESULT_CODE type and the zval_dtor() alias
(UPGRADING.INTERNALS). This is upstream pull request
https://github.com/m6w6/ext-raphf/pull/13 "Fix for PHP 8.6.0beta3" by Remi
Collet (commit 8ef73eb706, open as of 2026-11-05). Drop once it is merged and
released.

diff --git a/php_raphf.h b/php_raphf.h
index 06703a5..c4ada9f 100644
--- a/php_raphf.h
+++ b/php_raphf.h
@@ -30,6 +30,10 @@ extern zend_module_entry raphf_module_entry;
 #	include "TSRM.h"
 #endif
 
+#if PHP_VERSION_ID < 80000
+typedef ZEND_RESULT_CODE zend_result;
+#endif
+
 #include "php_raphf_api.h"
 
 #endif	/* PHP_RAPHF_H */
diff --git a/src/php_raphf_api.c b/src/php_raphf_api.c
index d71ce36..ba74d10 100644
--- a/src/php_raphf_api.c
+++ b/src/php_raphf_api.c
@@ -309,7 +309,7 @@ static void php_persistent_handle_hash_dtor(zval *p)
 	pefree(provider, 1);
 }
 
-ZEND_RESULT_CODE php_persistent_handle_provide(zend_string *name,
+zend_result php_persistent_handle_provide(zend_string *name,
 		php_resource_factory_ops_t *fops, void *data, void (*dtor)(void *))
 {
 	php_persistent_handle_provider_t *provider = pemalloc(sizeof(*provider), 1);
@@ -528,7 +528,7 @@ static PHP_FUNCTION(raphf_stat_persistent_handles)
 		if (php_persistent_handle_statall(HASH_OF(return_value))) {
 			return;
 		}
-		zval_dtor(return_value);
+		zval_ptr_dtor_nogc(return_value);
 	}
 	RETURN_FALSE;
 }
diff --git a/src/php_raphf_api.h b/src/php_raphf_api.h
index b8b4458..decf46a 100644
--- a/src/php_raphf_api.h
+++ b/src/php_raphf_api.h
@@ -226,7 +226,7 @@ struct php_persistent_handle_factory {
  * @param dtor \a data destructor
  * @return SUCCESS/FAILURE
  */
-PHP_RAPHF_API ZEND_RESULT_CODE php_persistent_handle_provide(
+PHP_RAPHF_API zend_result php_persistent_handle_provide(
 		zend_string *name, php_resource_factory_ops_t *fops,
 		void *data, void (*dtor)(void *));
 
