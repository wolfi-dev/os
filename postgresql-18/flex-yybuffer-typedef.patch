Description: Define the yybuffer typedef used by flex >= 2.6.5.
 psqlscan_int.h is included from the %top block of the flex files and defines
 YY_TYPEDEF_YY_BUFFER_STATE, which makes flex skip its own buffer typedefs.
 Newer flex emits "yybuffer" in the generated scanner, so define it here as
 well. Redundant typedefs are valid C11, so older flex is unaffected.

--- a/src/include/fe_utils/psqlscan_int.h
+++ b/src/include/fe_utils/psqlscan_int.h
@@ -54,6 +54,8 @@
 #ifndef YY_TYPEDEF_YY_BUFFER_STATE
 #define YY_TYPEDEF_YY_BUFFER_STATE
 typedef struct yy_buffer_state *YY_BUFFER_STATE;
+/* flex >= 2.6.5 also uses this name; our guard above suppresses its typedef */
+typedef struct yy_buffer_state *yybuffer;
 #endif
 #ifndef YY_TYPEDEF_YY_SCANNER_T
 #define YY_TYPEDEF_YY_SCANNER_T
