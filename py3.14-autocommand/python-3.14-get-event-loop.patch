Subject: Fix asyncio.get_event_loop() use for Python 3.14+

Since Python 3.14, asyncio.get_event_loop() raises RuntimeError when there
is no current event loop instead of implicitly creating one (3.12 and 3.13
only emitted a DeprecationWarning).

- src/autocommand/autoasync.py: when @autoasync is used without loop= and
  there is no current loop, create one with asyncio.new_event_loop() and
  make it current with asyncio.set_event_loop(), preserving the documented
  behaviour. Written for Chainguard; not yet upstream.
- test/test_autoasync.py: tolerate there being no prior loop in the
  temporary_context_loop fixture. Taken from upstream PR
  https://github.com/Lucretiel/autocommand/pull/40 (Miro Hroncok), carried
  by Fedora as 002-python3.14-fix.patch.

Upstream issue: https://github.com/Lucretiel/autocommand/issues/39
---
diff --git a/src/autocommand/autoasync.py b/src/autocommand/autoasync.py
index 688f7e0..5907b28 100644
--- a/src/autocommand/autoasync.py
+++ b/src/autocommand/autoasync.py
@@ -15,7 +15,7 @@
 # You should have received a copy of the GNU Lesser General Public License
 # along with autocommand.  If not, see <http://www.gnu.org/licenses/>.
 
-from asyncio import get_event_loop, iscoroutine
+from asyncio import get_event_loop, iscoroutine, new_event_loop, set_event_loop
 from functools import wraps
 from inspect import signature
 
@@ -115,7 +115,17 @@ def autoasync(coro=None, *, loop=None, forever=False, pass_loop=False):
     def autoasync_wrapper(*args, **kwargs):
         # Defer the call to get_event_loop so that, if a custom policy is
         # installed after the autoasync decorator, it is respected at call time
-        local_loop = get_event_loop() if loop is None else loop
+        if loop is None:
+            # Python 3.14+ raises RuntimeError instead of implicitly creating
+            # a loop when there is no current event loop; restore the old
+            # behaviour by creating one and making it current.
+            try:
+                local_loop = get_event_loop()
+            except RuntimeError:
+                local_loop = new_event_loop()
+                set_event_loop(local_loop)
+        else:
+            local_loop = loop
 
         # Inject the 'loop' argument. We have to use this signature binding to
         # ensure it's injected in the correct place (positional, keyword, etc)
diff --git a/test/test_autoasync.py b/test/test_autoasync.py
index 816be30..37af9ee 100644
--- a/test/test_autoasync.py
+++ b/test/test_autoasync.py
@@ -32,7 +32,10 @@ def temporary_context_loop(loop):
     Set the given loop as the context loop (that is, the loop returned by
     asyncio.get_event_loop() for the duration of the context)
     '''
-    old_loop = asyncio.get_event_loop()
+    try:
+        old_loop = asyncio.get_event_loop()
+    except RuntimeError:
+        old_loop = None
     asyncio.set_event_loop(loop)
     try:
         yield loop
