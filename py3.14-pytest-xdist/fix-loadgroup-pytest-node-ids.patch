From 8f83805569c1fb03a6f686409e65a1723614743e Mon Sep 17 00:00:00 2001
From: itscloud0 <cloud0beats@gmail.com>
Date: Mon, 21 Sep 2026 11:54:28 +0400
Subject: [PATCH] Fix loadgroup with pytest main node IDs

Backport of upstream commit 8f83805569c1fb03a6f686409e65a1723614743e.
Newer pytest stores structured node IDs in ``_id`` and no longer honors
writes to ``_nodeid``, which broke ``--dist=loadgroup``.

---
 src/xdist/remote.py       | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/xdist/remote.py b/src/xdist/remote.py
index 4d7c926..ae8968e 100644
--- a/src/xdist/remote.py
+++ b/src/xdist/remote.py
@@ -261,7 +261,12 @@ class WorkerInteractor:
                     gnames.add(str(name))
                 if not gnames:
                     continue
-                item._nodeid = f"{item.nodeid}@{'_'.join(sorted(gnames))}"
+                nodeid = f"{item.nodeid}@{'_'.join(sorted(gnames))}"
+                node_id = getattr(item, "_id", None)
+                if node_id is None:
+                    item._nodeid = nodeid
+                else:
+                    item._id = node_id.parse(nodeid)
 
     @pytest.hookimpl
     def pytest_collection_finish(self, session: pytest.Session) -> None:
