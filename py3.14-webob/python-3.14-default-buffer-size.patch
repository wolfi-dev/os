Backport of upstream commit 447975febec7fc6bb088698bdeaa151bf5028a86
("Python 3.14 updated the DEFAULT_BUFFER_SIZE to be larger") to 1.8.11.
The fix is on webob main but not on the 1.8 branch, and no 1.8.x release
carries it: https://github.com/Pylons/webob/issues/479

Python 3.14 enlarged io.DEFAULT_BUFFER_SIZE, so
tests/test_in_wsgiref.py::test_interrupted_request, which hard-codes the
old size, fails. The patch below is Debian's backport from
debian/patches/0003-Python-3.14-updated-the-DEFAULT_BUFFER_SIZE-to-be-la.patch
in python-webob 1:1.8.11-1.

Upstream: https://github.com/Pylons/webob/commit/447975febec7fc6bb088698bdeaa151bf5028a86
Debian: https://sources.debian.org/src/python-webob/1:1.8.11-1/debian/patches/

From: Delta Regeer <bertjw@regeer.org>
Date: Sun, 15 Mar 2026 13:08:24 -0600
Subject: Python 3.14 updated the DEFAULT_BUFFER_SIZE to be larger

This broke the test that assumed it would be 8192. Fix things so that
the tests now correctly test things again.

Origin: upstream, https://github.com/Pylons/webob/commit/447975febec7fc6bb088698bdeaa151bf5028a86.patch
Bug-Debian: https://bugs.debian.org/1123459
---
 tests/test_in_wsgiref.py | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/tests/test_in_wsgiref.py b/tests/test_in_wsgiref.py
index 868b7c7..5944113 100644
--- a/tests/test_in_wsgiref.py
+++ b/tests/test_in_wsgiref.py
@@ -1,4 +1,5 @@
 import sys
+from io import DEFAULT_BUFFER_SIZE
 import logging
 import socket
 import cgi
@@ -15,6 +16,8 @@ from webob.compat import Empty

 log = logging.getLogger(__name__)

+TARGET_CL = DEFAULT_BUFFER_SIZE * 2
+
 @pytest.mark.usefixtures("serve")
 def test_request_reading(serve):
     """
@@ -61,7 +64,7 @@ _global_res = Queue()


 def _test_app_req_interrupt(env, sr):
-    target_cl = 100000
+    target_cl = TARGET_CL
     try:
         req = Request(env)
         cl = req.content_length
@@ -89,7 +92,7 @@ def _req_int_cgi(req):
 def _req_int_readline(req):
     try:
         assert req.body_file.readline() == b'a=b\n'
-    except IOError:
+    except IOError as exc:
         # too early to detect disconnect
         raise AssertionError("False disconnect alert")
     req.body_file.readline()
@@ -121,7 +124,7 @@ def _send_interrupted_req(server, path='/'):
 _interrupted_req = (
     "POST %s HTTP/1.0\r\n"
     "content-type: application/x-www-form-urlencoded\r\n"
-    "content-length: 100000\r\n"
+    f"content-length: {TARGET_CL}\r\n"
     "\r\n"
 )
-_interrupted_req += 'a=b\nz=' + 'x' * 10000
+_interrupted_req += 'a=b\nz=' + 'x' * DEFAULT_BUFFER_SIZE
