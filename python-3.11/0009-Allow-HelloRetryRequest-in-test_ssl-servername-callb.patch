From c545b55b5bc68b068b2db85967e03858ba865d94 Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Sat, 3 Oct 2026 15:15:09 +0000
Subject: [PATCH 09/10] Allow HelloRetryRequest in test_ssl servername callback
 tests

The servername callback is invoked for every ClientHello.  When the
server answers with a HelloRetryRequest, for example because the
OpenSSL configuration does not send a key share the server accepts,
it processes a second ClientHello and the callback is called again
with the same arguments.

Accept one or two identical calls per handshake in
test_get_server_certificate_sni and test_sni_callback, and check each
handshake of test_get_server_certificate_sni separately.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Lib/test/test_ssl.py | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/Lib/test/test_ssl.py b/Lib/test/test_ssl.py
index 96a590fbd57..2db3f9b3dcc 100644
--- a/Lib/test/test_ssl.py
+++ b/Lib/test/test_ssl.py
@@ -264,6 +264,17 @@ def wrapper(*args, **kw):
     return decorator
 
 
+def assert_servername_calls(testcase, calls, expected):
+    """Check the servername callback calls of a single handshake
+
+    The callback is invoked for every ClientHello.  If the server sends a
+    HelloRetryRequest (e.g. the client's key share is not acceptable), it
+    receives a second ClientHello and the callback is invoked again with
+    the same arguments.
+    """
+    testcase.assertIn(calls, ([expected], [expected, expected]))
+
+
 def handle_error(prefix):
     exc_format = ' '.join(traceback.format_exception(*sys.exc_info()))
     if support.verbose:
@@ -2424,14 +2435,15 @@ def servername_cb(ssl_sock, server_name, initial_context):
         pem = ssl.get_server_certificate((host, port))
         if not pem:
             self.fail("No server certificate on %s:%s!" % (host, port))
+        assert_servername_calls(self, server_names, host)
 
+        server_names.clear()
         pem = ssl.get_server_certificate((host, port), ca_certs=SIGNING_CA)
         if not pem:
             self.fail("No server certificate on %s:%s!" % (host, port))
         if support.verbose:
             sys.stdout.write("\nVerified certificate for %s:%s is\n%s\n" % (host, port, pem))
-
-        self.assertEqual(server_names, [host, host])
+        assert_servername_calls(self, server_names, host)
 
     def test_get_server_certificate_fail(self):
         # Connection failure crashes ThreadedEchoServer, so run this in an
@@ -4531,7 +4543,7 @@ def servername_cb(ssl_sock, server_name, initial_context):
         stats = server_params_test(client_context, server_context,
                                    chatty=True,
                                    sni_name=None)
-        self.assertEqual(calls, [(None, server_context)])
+        assert_servername_calls(self, calls, (None, server_context))
         self.check_common_name(stats, SIGNED_CERTFILE_HOSTNAME)
 
         # Check disabling the callback
