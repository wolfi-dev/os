The 3.14 backport of gh-149816 (race when fetching OpenSSL digests)
dropped the negation that main has in
`int fips = !disable_fips_property(py_ht);`. disable_fips_property()
returns 1 for usedforsecurity=False, so without the negation OpenSSL
digests are fetched with the "-fips" property query for
usedforsecurity=True and without it for usedforsecurity=False, which is
inverted. In FIPS mode this makes hashlib.new(..., usedforsecurity=True)
succeed for non-approved digests and usedforsecurity=False fail
(test_hashlib.test_builtins_in_openssl_fips_mode).

diff --git a/Modules/_hashopenssl.c b/Modules/_hashopenssl.c
--- a/Modules/_hashopenssl.c
+++ b/Modules/_hashopenssl.c
@@ -417,10 +417,11 @@ py_digest_by_name(PyObject *module, const char *name, enum Py_hash_type py_ht)
     PY_EVP_MD *digest = NULL, *fresh = NULL;
     _hashlibstate *state = get_hashlib_state(module);
     py_hashentry_t *entry = _Py_hashtable_get(state->hashtable, name);
-    int fips = disable_fips_property(py_ht);
-    if (fips == -1) {
+    int disable_fips = disable_fips_property(py_ht);
+    if (disable_fips == -1) {
         goto finally;
     }
+    int fips = !disable_fips;
 
     if (entry != NULL) {
         PY_EVP_MD **cached = fips ? &entry->evp : &entry->evp_nosecurity;
