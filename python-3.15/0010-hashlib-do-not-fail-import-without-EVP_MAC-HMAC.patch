From: Chainguard
Subject: [PATCH] hashlib: do not fail import when EVP_MAC HMAC cannot be fetched

In FIPS mode with no usable HMAC implementation (as in the mocked FIPS
configuration used by the package tests), EVP_MAC_fetch() fails. Leave
the module importable and report the failure from hmac_new() instead.

---
--- a/Modules/_hashopenssl.c
+++ b/Modules/_hashopenssl.c
@@ -2074,6 +2074,10 @@
      * by calling EVP_MAC_up_ref() and EVP_MAC_free() in EVP_MAC_CTX_new()
      * and EVP_MAC_CTX_free() respectively.
      */
+    if (state->evp_hmac == NULL) {
+        PyErr_SetString(PyExc_ValueError, "HMAC is not available");
+        return NULL;
+    }
     ctx = EVP_MAC_CTX_new(state->evp_hmac);
     if (ctx == NULL) {
         /* EVP_MAC_CTX_new() may also set an ERR_R_EVP_LIB error */
@@ -2821,9 +2825,10 @@
 #ifdef Py_HAS_OPENSSL3_SUPPORT
     state->evp_hmac = EVP_MAC_fetch(NULL, "HMAC", NULL);
     if (state->evp_hmac == NULL) {
+        /* HMAC may be unavailable, e.g. when the FIPS property query
+         * matches no implementation. Do not make the whole module
+         * unimportable; hmac_new() reports the failure when used. */
         ERR_clear_error();
-        PyErr_SetString(PyExc_ImportError, "cannot initialize EVP_MAC HMAC");
-        return -1;
     }
 #endif
 
