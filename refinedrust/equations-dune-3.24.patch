Build Equations 1.3.2+9.2 with dune 3.24, which removed the `coq`
extension of the dune language in favour of `rocq`, and without
ppx_optcomp, which here only selects a Rocq 9.0 variant of one function
(this build is for Rocq 9.2). The rocq extension needs dune language 3.21, so the
project's lang version moves from 3.13 to 3.21.

--- a/dune-project
+++ b/dune-project
@@ -1,5 +1,5 @@
-(lang dune 3.13)
-(using coq 0.8)
+(lang dune 3.21)
+(using rocq 0.11)
 (name rocq-equations)
 (source (github mattam82/Coq-Equations))
 (license LGPL-2.1-only)
--- a/examples/dune
+++ b/examples/dune
@@ -1,4 +1,4 @@
-(coq.theory
+(rocq.theory
  ; This determines the -R flag
  (name Equations.Examples)
  (package rocq-equations-examples)
--- a/src/dune
+++ b/src/dune
@@ -3,7 +3,6 @@
  (public_name rocq-equations.plugin)
  (flags :standard -w -9-27+60 -warn-error -3-9-32-33-50)
  (libraries rocq-runtime.plugins.cc rocq-runtime.plugins.extraction)
- (preprocess
-  (pps ppx_optcomp -- -cookie "ppx_optcomp.env=env ~rocq:(Defined \"%{coq:version.major}.%{coq:version.minor}\")")))
+)
 
-(coq.pp (modules g_equations))
+(rocq.pp (modules g_equations))
--- a/src/equations_common.ml
+++ b/src/equations_common.ml
@@ -1177,11 +1177,7 @@ let evd_comb1 f evd x =
 
 (* Universe related functions *)
 
-[%%if rocq = "9.0"]
-let set_leq_sort env = Evd.set_leq_sort env
-[%%else]
 let set_leq_sort _env = Evd.set_leq_sort
-[%%endif]
 
 let nonalgebraic_universe_level_of_universe env sigma u =
   match ESorts.kind sigma u with
