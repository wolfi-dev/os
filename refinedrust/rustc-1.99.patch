Build the frontend with the stable Rust release Wolfi ships (see the vars
block of refinedrust.yaml) instead of the nightly upstream pins
(rr_frontend/rust-toolchain.toml: nightly-2026-08-28). Between that
release and the nightly, the compiler renamed PredicatePolarity to
ClausePolarity and made a predicate list iterable without `.iter()`.

--- a/rr_frontend/translation/src/traits/requirements.rs
+++ b/rr_frontend/translation/src/traits/requirements.rs
@@ -10,7 +10,7 @@ use log::{info, trace};
 use radium::specs;
 use rr_rustc_interface::hir::def_id::DefId;
 use rr_rustc_interface::middle::ty::{self, TypeFoldable as _, TypeSuperFoldable as _};
-use rr_rustc_interface::type_ir::{ClausePolarity, Upcast as _};
+use rr_rustc_interface::type_ir::{PredicatePolarity as ClausePolarity, Upcast as _};
 
 use crate::base::TranslationError;
 use crate::error::Message;
@@ -65,7 +65,7 @@ pub(crate) fn get_trait_requirements_with_origin<'tcx>(
     // Determine whether we are declaring the scope of a trait method or trait impl method
     let in_trait_decl = tcx.trait_of_assoc(did);
 
-    let clauses = typing_env.param_env.caller_bounds().collect::<Vec<_>>();
+    let clauses = typing_env.param_env.caller_bounds().iter().collect::<Vec<_>>();
     info!("Caller bounds: {:?}", clauses);
 
     let in_trait_decl = if is_trait { Some(did) } else { in_trait_decl };
@@ -158,10 +158,10 @@ pub(crate) fn get_clauses_with_origin<'tcx>(
     // determine the origin of this requirement below
     let surrounding_reqs = if let Some(trait_did) = in_trait_decl {
         let trait_param_env = tcx.param_env(trait_did);
-        Some(trait_param_env.caller_bounds().collect())
+        Some(trait_param_env.caller_bounds().iter().collect())
     } else if let Some(impl_did) = in_trait_impl {
         let impl_param_env = tcx.param_env(impl_did);
-        Some(impl_param_env.caller_bounds().collect())
+        Some(impl_param_env.caller_bounds().iter().collect())
     } else {
         None
     };
