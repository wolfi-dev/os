From c9b47c963751d177d8d229647a70e57a3705f17e Mon Sep 17 00:00:00 2001
From: Sethu <s.c.arunachalam@lifelenz.com>
Date: Fri, 25 Sep 2026 14:40:12 +0930
Subject: [PATCH] [Bug #22384] Fix memory leak on compile error in a later
 branch of an alternation

(cherry picked from commit bf937bfa16767a4dd857ee16f4f18df1bae4d5ca)
---
 regparse.c               |  2 ++
 test/ruby/test_regexp.rb | 17 +++++++++++++++++
 2 files changed, 19 insertions(+)

diff --git a/regparse.c b/regparse.c
index 2a6b8a3b34..1babb5a0ce 100644
--- a/regparse.c
+++ b/regparse.c
@@ -6688,6 +6688,8 @@ parse_subexp(Node** top, OnigToken* tok, int term,
       }
       r = parse_branch(&node, tok, term, src, end, env);
       if (r < 0) {
+	/* the failed branch is not linked into topnode yet: free both */
+	onig_node_free(node);
 	onig_node_free(topnode);
 	return r;
       }
diff --git a/test/ruby/test_regexp.rb b/test/ruby/test_regexp.rb
index 3bb34ee149..83787f3bfe 100644
--- a/test/ruby/test_regexp.rb
+++ b/test/ruby/test_regexp.rb
@@ -999,6 +999,23 @@ def test_regsub_K
     assert_equal('foobazquux/foobazquux', result, bug8856)
   end
 
+  def test_alternation_compile_error_no_memory_leak
+    # A compile error in the 2nd+ branch of a top-level alternation leaked the
+    # partially parsed branch (parse_subexp freed the alternation list but not
+    # the node parse_branch had built so far). Regexp#to_s reaches this path
+    # for every /(?:a|b)c(d)/-shaped regexp.
+    assert_no_memory_leak([], "#{<<~"begin;"}", "#{<<~"end;"}", "[Bug #22384]", rss: true)
+      code = proc do
+        Regexp.new("a|b(c") rescue nil
+        /(?:a|b)c(d)/.to_s
+      end
+
+      1_000.times(&code)
+    begin;
+      300_000.times(&code)
+    end;
+  end
+
   def test_ignorecase
     v = assert_deprecated_warning(/variable \$= is no longer effective/) { $= }
     assert_equal(false, v)
-- 
