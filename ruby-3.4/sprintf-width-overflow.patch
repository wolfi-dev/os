From cdc1a947d3c4c1935e4e81fd3c37d9d6f1ba5919 Mon Sep 17 00:00:00 2001
From: Nobuyoshi Nakada <nobu@ruby-lang.org>
Date: Wed, 25 Mar 2026 14:00:02 +0900
Subject: [PATCH] sprintf.c: Fix width overflow

(cherry picked from commit e39475a544f08ce5f140213c740f2464933a2bae)
---
 sprintf.c                 | 21 ++++++++++-----------
 test/ruby/test_sprintf.rb |  6 ++++++
 2 files changed, 16 insertions(+), 11 deletions(-)

diff --git a/sprintf.c b/sprintf.c
index 90fe91cfa8..a44fa9f678 100644
--- a/sprintf.c
+++ b/sprintf.c
@@ -77,6 +77,11 @@ sign_bits(int base, const char *p)
     buf = RSTRING_PTR(result);\
 } while (0)
 
+#define CHECK_WIDTH(l, w) do { \
+    if ((l) > INT_MAX - (w)) rb_raise(rb_eArgError, "width too big");\
+    CHECK((l)+(w));\
+} while (0)
+
 #define PUSH(s, l) do { \
     CHECK(l);\
     PUSH_(s, l);\
@@ -482,19 +487,13 @@ rb_str_format_ary(int argc, const VALUE *argv, VALUE fmt, VALUE ary)
                     rb_enc_mbcput(c, &buf[blen], enc);
                     blen += n;
                 }
-                else if ((flags & FMINUS)) {
-                    --width;
-                    CHECK(n + (width > 0 ? width : 0));
-                    rb_enc_mbcput(c, &buf[blen], enc);
-                    blen += n;
-                    if (width > 0) FILL_(' ', width);
-                }
                 else {
                     --width;
-                    CHECK(n + (width > 0 ? width : 0));
-                    if (width > 0) FILL_(' ', width);
+                    CHECK_WIDTH(n, (width > 0 ? width : 0));
+                    if (!(flags & FMINUS) && (width > 0)) FILL_(' ', width);
                     rb_enc_mbcput(c, &buf[blen], enc);
                     blen += n;
+                    if ((flags & FMINUS) && (width > 0)) FILL_(' ', width);
                 }
             }
             break;
@@ -531,7 +530,7 @@ rb_str_format_ary(int argc, const VALUE *argv, VALUE fmt, VALUE ary)
                     /* need to adjust multi-byte string pos */
                     if ((flags&FWIDTH) && (width > slen)) {
                         width -= (int)slen;
-                        CHECK(len + width);
+                        CHECK_WIDTH(len, width);
                         if (!(flags&FMINUS)) {
                             FILL_(' ', width);
                             width = 0;
@@ -845,7 +844,7 @@ rb_str_format_ary(int argc, const VALUE *argv, VALUE fmt, VALUE ary)
                 if (sign || (flags&FSPACE)) ++len;
                 if (prec > 0) ++len; /* period */
                 fill = width > len ? width - len : 0;
-                CHECK(fill + len);
+                CHECK(fill + len); /* max(width, len) */
                 if (fill && !(flags&(FMINUS|FZERO))) {
                     FILL_(' ', fill);
                 }
diff --git a/test/ruby/test_sprintf.rb b/test/ruby/test_sprintf.rb
index 3a8ee077b9..a267249ae0 100644
--- a/test/ruby/test_sprintf.rb
+++ b/test/ruby/test_sprintf.rb
@@ -1,5 +1,6 @@
 # frozen_string_literal: false
 require 'test/unit'
+require 'rbconfig/sizeof'
 
 class TestSprintf < Test::Unit::TestCase
   def test_positional
@@ -553,6 +554,11 @@ def test_named_with_nil
   def test_width_underflow
     bug = 'https://github.com/mruby/mruby/issues/3347'
     assert_equal("!", sprintf("%*c", 0, ?!.ord), bug)
+
+    int_max = RbConfig::LIMITS["INT_MAX"]
+    assert_raise_with_message(ArgumentError, /width too big/) {
+      sprintf "%*c", int_max, 0x80
+    }
   end
 
   def test_negative_width_overflow
-- 
