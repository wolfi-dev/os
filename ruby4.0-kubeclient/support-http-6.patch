From bc0fa7f2183143db0285267a66ca99083b6e0064 Mon Sep 17 00:00:00 2001
From: Erik Berlin <sferik@gmail.com>
Date: Mon, 16 Mar 2026 20:17:18 -0700
Subject: [PATCH] Support http gem 6.0

Backport of upstream commit bc0fa7f from
https://github.com/ManageIQ/kubeclient/pull/687 (merged to master as
a63d8af, not yet in any release tag).

The upstream commit does not cherry-pick cleanly onto v4.13.0: master
is the 5.x line, whose kubeclient.gemspec has a different dependency
list (faraday instead of rest-client/jsonpath, newer dev deps), so the
gemspec hunks conflict. The lib/kubeclient/watch_stream.rb change is
taken verbatim. For the gemspec, only the runtime 'http' constraint
change ('< 6.0' -> '< 7.0') is applied; the development-only webmock
bump is dropped since it does not affect the built gem.

Drop this patch once a release includes the upstream change.
---
 kubeclient.gemspec             | 2 +-
 lib/kubeclient/watch_stream.rb | 6 +++++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/kubeclient.gemspec b/kubeclient.gemspec
index f2c4a48..18b17c1 100644
--- a/kubeclient.gemspec
+++ b/kubeclient.gemspec
@@ -39,5 +39,5 @@ Gem::Specification.new do |spec|
   spec.add_dependency 'jsonpath', '~> 1.0'
   spec.add_dependency 'rest-client', '~> 2.0'
   spec.add_dependency 'recursive-open-struct', '> 1.1.1', '< 3.0'
-  spec.add_dependency 'http', '>= 3.0', '< 6.0'
+  spec.add_dependency 'http', '>= 3.0', '< 7.0'
 end
diff --git a/lib/kubeclient/watch_stream.rb b/lib/kubeclient/watch_stream.rb
index b808120..a3acbfc 100644
--- a/lib/kubeclient/watch_stream.rb
+++ b/lib/kubeclient/watch_stream.rb
@@ -18,7 +18,11 @@ module Kubeclient
         @finished = false
 
         @http_client = build_client
-        response = @http_client.request(:get, @uri, build_client_options)
+        response = if HTTP::VERSION >= '6'
+                     @http_client.request(:get, @uri, **build_client_options)
+                   else
+                     @http_client.request(:get, @uri, build_client_options)
+                   end
         unless response.code < 300
           raise Kubeclient::HttpError.new(response.code, response.reason, response)
         end
