Fix nscd_flush_cache stub signature to accept const char * instead of int

The nscd_flush_cache stub in lib/nscd.h was changed to take an int
parameter, but the callers in lib/commonio.c pass string arguments
("passwd", "group"). Fix the stub to match the real function signature
which takes a const char *.

--- a/lib/nscd.h
+++ b/lib/nscd.h
@@ -8,7 +8,7 @@
 #ifdef	USE_NSCD
 extern int nscd_flush_cache (const char *service);
 #else
 static inline int
-nscd_flush_cache(MAYBE_UNUSED int _1)
+nscd_flush_cache(MAYBE_UNUSED const char *_1)
 {
 	return 0;
 }
