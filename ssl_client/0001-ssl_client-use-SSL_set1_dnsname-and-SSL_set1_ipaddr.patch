From 8fb572327a7bfb593866bc16f58b373a384c74aa Mon Sep 17 00:00:00 2001
From: Aditya Tirmanwar <aditya.tirmanwar@chainguard.dev>
Date: Fri, 9 Oct 2026 17:13:37 +0000
Subject: [PATCH] ssl_client: use SSL_set1_dnsname/SSL_set1_ipaddr for OpenSSL
 4.0

Chainguard-authored; there is no upstream fix. OpenSSL 4.0 deprecates
SSL_set1_host() and a no-deprecated build removes it. Pick
SSL_set1_ipaddr() for IPv4/IPv6 literals and SSL_set1_dnsname()
otherwise, keeping the existing hostflags and NULL-name behavior.
---
 main/busybox/ssl_client.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/main/busybox/ssl_client.c b/main/busybox/ssl_client.c
index 45c62a5c..a2a03ede 100644
--- a/main/busybox/ssl_client.c
+++ b/main/busybox/ssl_client.c
@@ -1,3 +1,4 @@
+#include <arpa/inet.h>
 #include <err.h>
 #include <errno.h>
 #include <poll.h>
@@ -25,6 +26,19 @@ static void ssl_fatal(const char *msg)
 	errx(1, "%s", msg);
 }
 
+/* SSL_set1_dnsname() accepts IP literals without matching them against
+ * IP address SANs, so IP literals must go through SSL_set1_ipaddr().
+ */
+static int set_verify_host(SSL *ssl, const char *host)
+{
+	unsigned char addr[sizeof(struct in6_addr)];
+
+	if (host && (inet_pton(AF_INET, host, addr) == 1 ||
+		     inet_pton(AF_INET6, host, addr) == 1))
+		return SSL_set1_ipaddr(ssl, host);
+	return SSL_set1_dnsname(ssl, host);
+}
+
 static void copy_from_stdin_to_tls(SSL *ssl, int *fd)
 {
 	static size_t buf[BUFSIZE];
@@ -172,7 +186,7 @@ int main(int argc, char *argv[])
 	if (SSL_set_tlsext_host_name(ssl, sni) != 1)
 		ssl_fatal("SSL_set_tlsext_host_name");
 
-	if (SSL_set1_host(ssl, sni) != 1)
+	if (set_verify_host(ssl, sni) != 1)
 		ssl_fatal(sni);
 
 	if (!insecure) {
-- 
2.51.2

