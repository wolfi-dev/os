   int i;
   int alt_type;
   bool retval = false;
@@ -272,7 +272,7 @@ validate_hostname(X509 *x, std::string_view hostname, bool is_ip, char **peernam
   name = X509_get_subject_name(x);
 
   while ((i = X509_NAME_get_index_by_NID(name, NID_commonName, i)) >= 0) {
-    ASN1_STRING *str;
+    const ASN1_STRING *str;
     int astrlen;
