 plugins/certifier/certifier.cc                | 18 +++++++++++++++---
 src/traffic_server/InkAPI.cc                  |  4 ++--
 src/tscore/X509HostnameValidator.cc           | 10 +++++-----
 tests/tools/plugins/ssl_client_verify_test.cc |  6 +++---
 6 files changed, 30 insertions(+), 18 deletions(-)

