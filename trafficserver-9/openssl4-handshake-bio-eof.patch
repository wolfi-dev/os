From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brian Neradt <brian.neradt@gmail.com>
Date: Thu, 1 Oct 2026 18:10:35 +0000
Subject: [PATCH 3/3] Handle OpenSSL 4 handshake buffer exhaustion

TLS handshakes stall with OpenSSL 4 because an empty memory BIO no
longer reports EOF when its empty-read behavior requests a retry. ATS
therefore retains the exhausted handshake buffer and never resumes
reading the client connection.

This patch checks the pending byte count to detect exhausted handshake
buffers and resume socket reads. This check also works with earlier
OpenSSL releases and removes the unused BoringSSL EOF fallback.

Backport to 9.2.15: same change, only the path (iocore/net/ instead of
src/iocore/net/) and the surrounding context differ. Upstream
cherry-picked it to 10.2.x for 10.2.1 (#13803); it is not in 10.2.0.

Upstream: https://github.com/apache/trafficserver/pull/13761
(cherry picked from commit fe7cfc94278d05e0eb772f08a14628a0141437e3)
---
 iocore/net/SSLNetVConnection.cc | 12 ++++--------
 1 file changed, 4 insertions(+), 8 deletions(-)

diff --git a/iocore/net/SSLNetVConnection.cc b/iocore/net/SSLNetVConnection.cc
index 6a24178..4a35baa 100644
--- a/iocore/net/SSLNetVConnection.cc
+++ b/iocore/net/SSLNetVConnection.cc
@@ -53,11 +53,6 @@ using namespace std::literals;
 #include <openssl/async.h>
 #endif
 
-// This is missing from BoringSSL
-#ifndef BIO_eof
-#define BIO_eof(b) (int)BIO_ctrl(b, BIO_CTRL_EOF, 0, nullptr)
-#endif
-
 #define SSL_READ_ERROR_NONE 0
 #define SSL_READ_ERROR 1
 #define SSL_READ_READY 2
@@ -515,7 +510,8 @@ bool
 SSLNetVConnection::update_rbio(bool move_to_socket)
 {
   bool retval = false;
-  if (BIO_eof(SSL_get_rbio(this->ssl)) && this->handShakeReader != nullptr) {
+  // OpenSSL 4 does not report EOF for an empty memory BIO configured to retry reads.
+  if (this->handShakeReader != nullptr && BIO_ctrl_pending(SSL_get_rbio(this->ssl)) == 0) {
     Debug("ssl", "Consuming handShakeBioStored=%d bytes from the handshake reader", this->handShakeBioStored);
     this->handShakeReader->consume(this->handShakeBioStored);
     this->handShakeBioStored = 0;
@@ -1286,8 +1282,8 @@ SSLNetVConnection::sslServerHandShakeEvent(int &err)
   // We only feed CLIENT_HELLO bytes into our temporary buffers. If we are past
   // the CLIENT_HELLO, then no need to buffer.
   if (in_client_hello && this->handShakeReader) {
-    if (BIO_eof(SSL_get_rbio(this->ssl))) { // No more data in the buffer
-                                            // Is this the first read?
+    if (BIO_ctrl_pending(SSL_get_rbio(this->ssl)) == 0) { // No more data in the buffer
+                                                          // Is this the first read?
 #if TS_USE_TLS_ASYNC
       if (SSLConfigParams::async_handshake_enabled) {
         SSL_set_mode(ssl, SSL_MODE_ASYNC);
