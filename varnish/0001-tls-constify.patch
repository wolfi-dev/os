From 1e1c99347ff7bdb5fb7f49d1830c776649b0ebc0 Mon Sep 17 00:00:00 2001
From: Azimjon Ulmasov <azimjon.ulmasov@chainguard.dev>
Date: Thu, 9 Oct 2026 00:40:00 +0000
Subject: [PATCH] tls: constify

Backport of upstream varnish/varnish commit 1e1c99347ff (Guillaume Quintard).
OpenSSL 4.0 returns const pointers from X509_get_subject_name() and
X509_NAME_get_entry(), which fails under -Werror=discarded-qualifiers.
---
 bin/vinyld/tls/cache_client_ssl.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/bin/vinyld/tls/cache_client_ssl.c b/bin/vinyld/tls/cache_client_ssl.c
index 3815c6bdb..9c384724e 100644
--- a/bin/vinyld/tls/cache_client_ssl.c
+++ b/bin/vinyld/tls/cache_client_ssl.c
@@ -371,8 +371,8 @@ vtls_load_x509_names(struct cli *cli, struct vtls *vtls,
 
 	/* Extract CN for display purposes */
 	{
-		X509_NAME *x509_name;
-		X509_NAME_ENTRY *x509_entry;
+		const X509_NAME *x509_name;
+		const X509_NAME_ENTRY *x509_entry;
 
 		x509_name = X509_get_subject_name(x509);
 		if (x509_name != NULL) {
@@ -437,8 +437,8 @@ do {									\
 
 	/* Fall back to Common Name if no SANs */
 	if (nb == 0) {
-		X509_NAME *x509_name;
-		X509_NAME_ENTRY *x509_entry;
+		const X509_NAME *x509_name;
+		const X509_NAME_ENTRY *x509_entry;
 
 		x509_name = X509_get_subject_name(x509);
 		if (x509_name != NULL) {
