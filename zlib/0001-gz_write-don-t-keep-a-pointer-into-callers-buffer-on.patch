From 74e8280d25987b66e657d088eaa3c8a7169cafab Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@chainguard.dev>
Date: Tue, 15 Sep 2026 15:08:46 +0100
Subject: [PATCH] gz_write: don't keep a pointer into callers buffer on error

---
 gzwrite.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/gzwrite.c b/gzwrite.c
index b5026e5..e94a29c 100644
--- a/gzwrite.c
+++ b/gzwrite.c
@@ -242,8 +242,12 @@ local z_size_t gz_write(gz_statep state, voidpc buf, z_size_t len) {
             n -= state->strm.avail_in;
             state->x.pos += n;
             len -= n;
-            if (ret == -1)
+            if (ret == -1) {
+                /* don't keep a pointer into the caller's buffer */
+                state->strm.avail_in = 0;
+                state->strm.next_in = state->in;
                 return state->again ? put - len : 0;
+            }
         } while (len);
     }
 
